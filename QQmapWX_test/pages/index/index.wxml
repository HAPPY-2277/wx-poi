<!--index.wxml-->
<scroll-view class="scrollarea" scroll-y type="list">
  <view class="container">

    <!--地图容器-->
    <map id="myMap"
      markers="{{markers}}"
      style="width:100%;height:400px;"
      longitude="116.313972"
      latitude="39.980014" 
      scale='16'>
    </map>
    <!--绑定点击事件-->
    <form bindsubmit="nearby_search">
      <input style="border:1px solid #000;" name="keyword" placeholder="请输入关键词"/>
      <button formType="submit">搜索</button>
    </form>
    
  </view>
</scroll-view>
