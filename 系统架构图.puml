@startuml
title POI数据采集与核验系统类图
!theme toy
skinparam classAttributeIconSize 0

' =========================
' 1. 用户与权限模块
' =========================
package "用户与权限模块" {
    class User {
        +userId: Long
        +username: String
        +role: String
        +avatar: String
        +phone: String
        +wechatId: String
    }

    class AuthService {
        +login()
        +logout()
        +checkPermission()
    }

    class UserService {
        +getUserInfo()
        +updateUserInfo()
    }

    UserService --> User
    AuthService --> User
}

' =========================
' 2. POI采集模块
' =========================
package "POI采集模块" {
    class POI {
        +poiId: Long
        +name: String
        +category: String
        +latitude: double
        +longitude: double
        +description: String
        +status: String
    }

    class Photo {
        +photoId: Long
        +url: String
        +timestamp: Date
    }

    class CollectionService {
        +createPOI()
        +uploadPhoto()
        +submitPOI()
    }

    class LocationService {
        +getCurrentLocation()
    }

    class CameraService {
        +takePhoto()
    }

    POI "1" -- "0..*" Photo
    CollectionService --> POI
    CollectionService --> Photo
    CollectionService --> LocationService
    CollectionService --> CameraService
}

' =========================
' 3. 核验模块
' =========================
package "核验模块" {
    class VerificationRecord {
        +recordId: Long
        +result: String
        +comment: String
        +timestamp: Date
    }

    class VerificationService {
        +getPendingPOIs()
        +submitVerification()
        +markError()
    }

    VerificationRecord --> POI
    VerificationService --> VerificationRecord
}

' =========================
' 4. 地图模块
' =========================
package "地图模块" {
    class MapService {
        +showMap()
        +addMarker()
        +filterByCategory()
    }

    class NavigationService {
        +planRoute()
        +startNavigation()
    }

    MapService --> POI
    NavigationService --> MapService
}

' =========================
' 5. OCR模块
' =========================
package "OCR模块" {
    class OCRService {
        +recognizeText()
    }

    class ClassificationService {
        +suggestCategory()
    }

    OCRService --> Photo
    ClassificationService --> OCRService
}

' =========================
' 6. 消息模块
' =========================
package "消息模块" {
    class Message {
        +messageId: Long
        +senderId: Long
        +receiverId: Long
        +type: String
        +content: String
        +timestamp: Date
    }

    class ChatService {
        +sendMessage()
        +receiveMessage()
        +createGroup()
    }

    class NotificationService {
        +broadcast()
        +pushToUser()
    }

    Message --> User
    ChatService --> Message
    NotificationService --> Message
}

' =========================
' 7. 任务流程模块
' =========================
package "任务流程模块" {
    class Task {
        +taskId: Long
        +type: String
        +status: String
        +assignedTo: Long
    }

    class WorkflowService {
        +assignTask()
        +updateStatus()
        +escalateDispute()
    }

    class Dispute {
        +disputeId: Long
        +status: String
        +resolution: String
    }

    Task --> POI
    WorkflowService --> Task
    WorkflowService --> Dispute
}

' =========================
' 8. 第三方复核模块
' =========================
package "第三方复核模块" {
    class ThirdPartyReview {
        +reviewId: Long
        +result: String
        +finalDecision: String
    }

    class ThirdPartyService {
        +handleDispute()
        +submitFinalResult()
    }

    ThirdPartyReview --> POI
    ThirdPartyService --> ThirdPartyReview
    ThirdPartyService --> Dispute
}

' =========================
' 9. 数据模块（抽象表示）
' =========================
package "数据模块（抽象表示）" {
    class Database {
        +save()
        +update()
        +delete()
        +query()
    }

    Database <-- UserService
    Database <-- CollectionService
    Database <-- VerificationService
    Database <-- Message
    Database <-- Task
}

' =========================
' 10. 管理模块
' =========================
package "管理模块" {
    class AdminService {
        +manageUsers()
        +publishAnnouncement()
        +viewStatistics()
    }

    AdminService --> User
    AdminService --> Task
    AdminService --> Message
}

@enduml