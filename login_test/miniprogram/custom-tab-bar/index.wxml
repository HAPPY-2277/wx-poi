<view class="tab-bar">
  <view class="tab-content">
    <!-- 地图 - index 0 -->
    <view 
      class="tab-item {{selected === 0 ? 'active' : ''}}" 
      data-index="0"
      bindtap="switchTab"
    >
      <text class="tab-icon">🗺️</text>
      <text class="tab-text">地图</text>
    </view>
    
    <!-- 聊天 - index 1 -->
    <view 
      class="tab-item {{selected === 1 ? 'active' : ''}}" 
      data-index="1"
      bindtap="switchTab"
    >
      <text class="tab-icon">💬</text>
      <text class="tab-text">聊天</text>
    </view>
    
    <!-- 个人 - index 2 -->
    <view 
      class="tab-item {{selected === 2 ? 'active' : ''}}" 
      data-index="2"
      bindtap="switchTab"
    >
      <text class="tab-icon">👤</text>
      <text class="tab-text">个人</text>
    </view>
  </view>
</view>