/* 地图页面样式 - 绿色主题配色系统 */

.container {
  position: relative;
  height: 100vh;
  width: 100%;
}

.user-info {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  z-index: 100;
  background: linear-gradient(135deg, #ffffff 0%, #f0fff4 100%);
  padding: 16rpx 24rpx;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(7, 193, 96, 0.15);
}

.user-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #1f2937;
}

.map {
  width: 100%;
  height: 100%;
}

.search-section {
  position: absolute;
  bottom: calc(100rpx + env(safe-area-inset-bottom) + 20rpx);
  left: 20rpx;
  right: 20rpx;
  z-index: 100;
}

.search-box {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #ffffff 0%, #f0fff4 100%);
  border-radius: 40rpx;
  padding: 16rpx 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.15);
}

.search-input {
  flex: 1;
  height: 48rpx;
  font-size: 28rpx;
  border: none;
  outline: none;
  background: transparent;
}

.search-input::placeholder {
  color: #9ca3af;
}

.search-btn {
  background: linear-gradient(135deg, #07c160 0%, #10b981 100%);
  color: #fff;
  font-size: 26rpx;
  padding: 12rpx 32rpx;
  border-radius: 32rpx;
  margin-left: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.3);
  transition: all 0.3s ease;
}

.search-btn::after {
  border: none;
}

.search-btn:active {
  transform: scale(0.95);
}

.suggestion-list {
  position: absolute;
  top: 100%;
  left: 0;
  right: 0;
  background: #ffffff;
  border-radius: 20rpx;
  margin-top: 12rpx;
  box-shadow: 0 8rpx 32rpx rgba(7, 193, 96, 0.2);
  max-height: 400rpx;
  overflow-y: auto;
}

.suggestion-item {
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #f3f4f6;
  transition: background-color 0.2s;
}

.suggestion-item:last-child {
  border-bottom: none;
}

.suggestion-item:active {
  background-color: #f0fff4;
}

.item-content {
  display: flex;
  flex-direction: column;
}

.item-title {
  font-size: 28rpx;
  color: #1f2937;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.item-address {
  font-size: 24rpx;
  color: #9ca3af;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.location-btn {
  position: absolute;
  right: 30rpx;
  bottom: calc(220rpx + env(safe-area-inset-bottom));
  z-index: 100;
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #ffffff 0%, #f0fff4 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.2);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.location-btn:active {
  transform: scale(0.95);
}

.location-text {
  font-size: 24rpx;
  color: #07c160;
  font-weight: 600;
}

.marker-popup {
  position: fixed;
  left: 30rpx;
  right: 30rpx;
  bottom: calc(280rpx + env(safe-area-inset-bottom));
  background: linear-gradient(135deg, #ffffff 0%, #f0fff4 100%);
  border-radius: 24rpx;
  padding: 30rpx;
  box-shadow: 0 8rpx 32rpx rgba(7, 193, 96, 0.25);
  z-index: 150;
}

.popup-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.popup-title {
  flex: 1;
  font-size: 32rpx;
  font-weight: bold;
  color: #1f2937;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.popup-close {
  font-size: 48rpx;
  color: #9ca3af;
  padding: 0 10rpx;
  line-height: 1;
}

.popup-body {
  margin-top: 20rpx;
}

.popup-actions {
  display: flex;
  gap: 20rpx;
}

.action-btn {
  flex: 1;
  height: 80rpx;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
}

.action-btn::after {
  border: none;
}

.route-btn {
  background: linear-gradient(135deg, #07c160 0%, #10b981 100%);
  color: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(7, 193, 96, 0.3);
}

.detail-btn {
  background: #ffffff;
  color: #07c160;
  border: 2rpx solid #07c160;
}

.route-panel {
  position: fixed;
  left: 30rpx;
  right: 30rpx;
  bottom: calc(220rpx + env(safe-area-inset-bottom));
  background: linear-gradient(135deg, #ffffff 0%, #f0fff4 100%);
  border-radius: 24rpx;
  padding: 30rpx;
  box-shadow: 0 8rpx 32rpx rgba(7, 193, 96, 0.25);
  z-index: 200;
}

.route-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.route-title {
  flex: 1;
  font-size: 30rpx;
  font-weight: bold;
  color: #1f2937;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.route-close {
  font-size: 48rpx;
  color: #9ca3af;
  padding: 0 10rpx;
  line-height: 1;
}

.route-body {
  display: flex;
  gap: 40rpx;
  margin-bottom: 24rpx;
}

.route-item {
  display: flex;
  flex-direction: column;
}

.route-label {
  font-size: 24rpx;
  color: #9ca3af;
  margin-bottom: 8rpx;
}

.route-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #1f2937;
}

.nav-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #07c160 0%, #10b981 100%);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: bold;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(7, 193, 96, 0.3);
}

.nav-btn::after {
  border: none;
}

.nav-btn:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(7, 193, 96, 0.2);
}
