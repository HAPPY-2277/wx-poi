.container {
  position: relative;
  height: 100vh;
  width: 100%;
}

.user-info {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  z-index: 100;
  background: rgba(255, 255, 255, 0.95);
  padding: 16rpx 24rpx;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.user-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.map {
  width: 100%;
  height: 100%;
}

.search-bar {
  position: absolute;
  bottom: 40rpx;
  left: 20rpx;
  right: 20rpx;
  z-index: 100;
}

.search-box {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 40rpx;
  padding: 16rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

.search-input {
  flex: 1;
  height: 48rpx;
  font-size: 28rpx;
  border: none;
  outline: none;
}

.search-btn {
  background: #07c160;
  color: #fff;
  font-size: 26rpx;
  padding: 12rpx 32rpx;
  border-radius: 32rpx;
  margin-left: 16rpx;
}

.search-btn::after {
  border: none;
}

.location-btn {
  position: absolute;
  right: 30rpx;
  bottom: 160rpx;
  z-index: 100;
  width: 100rpx;
  height: 100rpx;
  background: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
}

.location-text {
  font-size: 24rpx;
  color: #07c160;
  font-weight: bold;
}