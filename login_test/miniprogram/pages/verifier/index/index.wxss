/* 核验者首页样式 */

/* 页面容器 */
.container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background: #f6f6f6;
  padding: 20rpx;
}

/* 角色头部信息 */
.role-header {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.avatar-wrapper {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  overflow: hidden;
  margin-right: 24rpx;
}

.avatar {
  width: 100%;
  height: 100%;
}

.user-info {
  display: flex;
  flex-direction: column;
}

.nickname {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.role-badge {
  display: inline-flex;
  align-items: center;
  background: #409eff;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.role-text {
  font-size: 24rpx;
  color: #fff;
}

/* 统计区域 */
.statistics-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
}

.statistics-cards {
  display: flex;
  justify-content: space-between;
}

.stat-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx;
}

.stat-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.pending-icon {
  background: #fef0f0;
}

.pending-icon .icon-text {
  color: #f56c6c;
  font-size: 36rpx;
  font-weight: bold;
}

.today-icon {
  background: #f0f9ff;
}

.today-icon .icon-text {
  color: #409eff;
  font-size: 36rpx;
  font-weight: bold;
}

.rate-icon {
  background: #f0fdf4;
}

.rate-icon .icon-text {
  color: #67c23a;
  font-size: 36rpx;
  font-weight: bold;
}

.stat-info {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
}

/* 功能入口区域 */
.function-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.function-entries {
  display: flex;
  flex-direction: column;
}

.function-card {
  display: flex;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.function-card:last-child {
  border-bottom: none;
}

.card-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  background: #f0f7ff;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.card-icon image {
  width: 48rpx;
  height: 48rpx;
}

.card-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.card-description {
  font-size: 26rpx;
  color: #999;
}

.card-arrow {
  margin-left: 16rpx;
}

.arrow-icon {
  font-size: 48rpx;
  color: #ccc;
  font-weight: bold;
}

/* 功能菜单按钮 */
.menu-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #409eff 0%, #66b1ff 100%);
  padding: 30rpx 40rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(64, 158, 255, 0.3);
}

.menu-btn-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
  margin-right: 16rpx;
}

.menu-icon {
  font-size: 36rpx;
  color: #fff;
}

/* 菜单弹窗遮罩 */
.menu-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

/* 菜单弹窗 */
.menu-popup {
  width: 100%;
  max-height: 70vh;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding-bottom: calc(env(safe-area-inset-bottom) + 100rpx);
  margin-bottom: 0;
  animation: slideUp 0.3s ease;
}

@keyframes slideUp {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

/* 弹窗头部 */
.popup-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.popup-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.close-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: #999;
  background: #f5f5f5;
  border-radius: 50%;
}

/* 菜单列表 */
.menu-list {
  padding: 16rpx 32rpx;
}

/* 菜单项 */
.menu-item {
  display: flex;
  align-items: center;
  padding: 32rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background: #f9f9f9;
}

.menu-item-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #f0f7ff 0%, #e6f0ff 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.menu-item-icon image {
  width: 48rpx;
  height: 48rpx;
}

.menu-item-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.menu-item-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.menu-item-desc {
  font-size: 26rpx;
  color: #999;
}

.menu-item-badge {
  background: #f56c6c;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  margin-right: 16rpx;
}

.badge-text {
  font-size: 24rpx;
  color: #fff;
  font-weight: 600;
}

.menu-arrow {
  font-size: 48rpx;
  color: #ccc;
  font-weight: bold;
}
