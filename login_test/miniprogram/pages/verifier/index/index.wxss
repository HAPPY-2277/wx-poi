/* 核验者首页样式 - 绿色主题配色系统 */

/* 页面容器 */
.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #f0fff4 0%, #f5f5f5 100%);
  padding-bottom: 20rpx;
}

/* 角色头部信息 */
.header {
  position: relative;
  background: linear-gradient(135deg, #07c160 0%, #10b981 50%, #06b5b7 100%);
  padding: 40rpx 30rpx;
  overflow: hidden;
}

.user-info {
  position: relative;
  z-index: 10;
  display: flex;
  align-items: center;
  flex-direction: row;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.8);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
  margin-right: 24rpx;
}

.info {
  display: flex;
  flex-direction: column;
}

.nickname {
  font-size: 36rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 8rpx;
}

.role-tag {
  display: inline-block;
  padding: 6rpx 16rpx;
  background-color: rgba(255, 255, 255, 0.25);
  color: #ffffff;
  font-size: 24rpx;
  border-radius: 20rpx;
}

.header-bg {
  position: absolute;
  top: 0;
  right: 0;
  width: 300rpx;
  height: 200rpx;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.15) 0%, transparent 70%);
  border-radius: 50%;
  transform: translate(50%, -50%);
}

/* 统计数据区域 */
.stats-container {
  padding: 0 30rpx;
  margin-top: -40rpx;
}

.stats-card {
  background-color: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(7, 193, 96, 0.1);
  padding: 32rpx 20rpx;
  display: flex;
  justify-content: space-around;
  align-items: center;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  position: relative;
}

.stat-item:not(:last-child)::after {
  content: '';
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 1rpx;
  height: 48rpx;
  background: #e5e7eb;
}

.stat-value {
  font-size: 48rpx;
  font-weight: bold;
  color: #07c160;
  margin-bottom: 8rpx;
  text-shadow: 0 2rpx 8rpx rgba(7, 193, 96, 0.2);
}

.stat-label {
  font-size: 26rpx;
  color: #6b7280;
  letter-spacing: 1rpx;
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background-color: #e5e5e5;
}

/* 功能入口区域 */
.function-container {
  padding: 30rpx;
  margin-top: 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #1f2937;
  margin-bottom: 24rpx;
}

.function-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
}

.function-card {
  background-color: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 6rpx 20rpx rgba(7, 193, 96, 0.08);
  padding: 30rpx;
  position: relative;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.function-card:active {
  transform: scale(0.98);
  box-shadow: 0 3rpx 10rpx rgba(7, 193, 96, 0.06);
}

.card-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}

.card-icon image {
  width: 48rpx;
  height: 48rpx;
}

/* 不同功能卡片图标颜色 */
.task-icon {
  background: linear-gradient(135deg, #07c160 0%, #10b981 100%);
}

.verify-icon {
  background: linear-gradient(135deg, #409eff 0%, #66b1ff 100%);
}

.review-icon {
  background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
}

.map-icon {
  background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 100%);
}

.card-content {
  display: flex;
  flex-direction: column;
}

.card-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #1f2937;
  margin-bottom: 8rpx;
}

.card-desc {
  font-size: 24rpx;
  color: #6b7280;
  line-height: 1.4;
}

/* 角标 */
.badge {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  min-width: 36rpx;
  height: 36rpx;
  background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
  color: #ffffff;
  font-size: 22rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 10rpx;
  box-shadow: 0 2rpx 8rpx rgba(239, 68, 68, 0.4);
}

/* 加载状态 */
.loading {
  text-align: center;
  padding: 40rpx;
  color: #6b7280;
  font-size: 28rpx;
}

/* 未登录提示视图 */
.not-logged-in-view {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 60rpx;
  background: linear-gradient(135deg, #ffffff 0%, #f0fff4 100%);
  margin: 30rpx;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(7, 193, 96, 0.1);
}

.lock-icon {
  font-size: 100rpx;
  margin-bottom: 40rpx;
}

.lock-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #1f2937;
  margin-bottom: 20rpx;
}

.lock-desc {
  font-size: 28rpx;
  color: #6b7280;
  text-align: center;
  margin-bottom: 60rpx;
  line-height: 1.5;
}

.login-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #07c160 0%, #10b981 100%);
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.3);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.login-btn::after {
  border: none;
}

.login-btn:active {
  transform: scale(0.96);
  box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.2);
}

.login-btn text {
  font-size: 32rpx;
  color: #ffffff;
  font-weight: bold;
}
