<!-- 核验者首页 -->
<!-- 功能：展示用户信息、统计数据卡片和功能入口 -->
<view class="container">

  <!-- 角色头部信息 -->
  <view class="role-header" style="width: 354rpx; height: 220rpx; display: flex; box-sizing: border-box">
    <view class="avatar-wrapper">
      <image
        class="avatar"
        src="{{userInfo.avatar || '/images/avatar.png'}}"
        mode="aspectFill"
        binderror="onAvatarError"
      />
    </view>
    <view class="user-info">
      <text class="nickname">{{displayNickname}}</text>
      <view class="role-badge">
        <text class="role-text">核验者</text>
      </view>
    </view>
  </view>

  <!-- 统计数据区域 -->
  <view class="statistics-section" style="width: 556rpx; height: 347rpx; display: block; box-sizing: border-box; left: -72rpx; top: 0rpx">
    <view class="section-title">审核概览</view>

    <view class="statistics-cards">
      <!-- 待审核数量 -->
      <view class="stat-card">
        <view class="stat-icon pending-icon">
          <text class="icon-text">!</text>
        </view>
        <view class="stat-info">
          <text class="stat-value">{{statistics.pendingCount}}</text>
          <text class="stat-label">待审核</text>
        </view>
      </view>

      <!-- 今日已审核 -->
      <view class="stat-card">
        <view class="stat-icon today-icon">
          <text class="icon-text">✓</text>
        </view>
        <view class="stat-info">
          <text class="stat-value">{{statistics.todayVerified}}</text>
          <text class="stat-label">今日已审</text>
        </view>
      </view>

      <!-- 审核通过率 -->
      <view class="stat-card">
        <view class="stat-icon rate-icon">
          <text class="icon-text">%</text>
        </view>
        <view class="stat-info">
          <text class="stat-value">{{statistics.approvalRate}}%</text>
          <text class="stat-label">通过率</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 功能入口区域 -->
  <view class="function-section" style="height: 170rpx; display: block; box-sizing: border-box; color: aliceblue">
    <!-- 功能菜单按钮 -->
    <view class="menu-btn" bindtap="showMenu">
      <text class="menu-btn-text">功能菜单</text>
      <text class="menu-icon">☰</text>
    </view>
  </view>

  <!-- 功能菜单弹窗 -->
  <view class="menu-overlay" wx:if="{{showMenuPopup}}" bindtap="hideMenu">
    <view class="menu-popup" catchtap="stopPropagation">
      <view class="popup-header">
        <text class="popup-title">功能菜单</text>
        <view class="close-btn" bindtap="hideMenu">×</view>
      </view>
      <view class="menu-list">
        <block wx:for="{{functionList}}" wx:key="id">
          <view
            class="menu-item"
            data-id="{{item.id}}"
            data-path="{{item.path}}"
            bindtap="onMenuItemTap"
          >
            <view class="menu-item-icon">
              <image src="{{item.icon}}" mode="aspectFit" />
            </view>
            <view class="menu-item-content">
              <text class="menu-item-title">{{item.title}}</text>
              <text class="menu-item-desc">{{item.desc}}</text>
            </view>
            <view class="menu-item-badge" wx:if="{{item.id === 'verify-list' && item.badge > 0}}">
              <text class="badge-text">{{item.badge}}</text>
            </view>
            <text class="menu-arrow">›</text>
          </view>
        </block>
      </view>
    </view>
  </view>

</view>
