/* 发布任务页面样式 - 绿色主题配色系统 */

/* 页面容器 */
.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #f0fff4 0%, #f5f5f5 100%);
  padding-bottom: 160rpx;
}

/* 表单区域 */
.form-container {
  padding: 30rpx;
}

/* 表单项 */
.form-item {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(7, 193, 96, 0.08);
  transition: all 0.3s ease;
}

.form-item.error {
  border: 2rpx solid #ef4444;
}

.collector-form-item {
  padding-bottom: 20rpx;
}

/* 表单标签 */
.form-label {
  font-size: 28rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 16rpx;
}

.required {
  color: #ef4444;
  margin-left: 4rpx;
}

.optional {
  color: #999999;
  font-weight: normal;
  font-size: 24rpx;
  margin-left: 8rpx;
}

/* 输入框 */
.form-input {
  width: 100%;
  height: 80rpx;
  font-size: 28rpx;
  color: #333333;
  border: 1rpx solid #e5e5e5;
  border-radius: 8rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
}

.form-input.input-error {
  border-color: #ef4444;
}

/* 地址输入容器 */
.address-input-wrapper {
  position: relative;
  display: flex;
  align-items: center;
}

.address-input {
  padding-right: 60rpx;
}

.clear-btn {
  position: absolute;
  right: 20rpx;
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #e5e5e5;
  border-radius: 50%;
}

.clear-btn text {
  font-size: 32rpx;
  color: #999999;
}

/* 地址建议下拉列表 */
.suggestion-dropdown {
  position: absolute;
  left: 30rpx;
  right: 30rpx;
  background: #ffffff;
  border-radius: 16rpx;
  margin-top: 8rpx;
  box-shadow: 0 8rpx 32rpx rgba(7, 193, 96, 0.2);
  max-height: 360rpx;
  overflow-y: auto;
  z-index: 100;
}

.suggestion-item {
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #f3f4f6;
  transition: background-color 0.2s;
}

.suggestion-item:last-child {
  border-bottom: none;
}

.suggestion-item:active {
  background-color: #f0fff4;
}

.item-title {
  display: block;
  font-size: 28rpx;
  color: #1f2937;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.item-address {
  display: block;
  font-size: 24rpx;
  color: #9ca3af;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 选择项显示 */
.form-value {
  height: 80rpx;
  font-size: 28rpx;
  color: #333333;
  border: 1rpx solid #e5e5e5;
  border-radius: 8rpx;
  padding: 0 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.form-value.placeholder {
  color: #cccccc;
}

/* 分类图标 */
.category-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

/* 箭头 */
.arrow {
  font-size: 32rpx;
  color: #cccccc;
}

/* 多行文本框 */
.form-textarea {
  width: 100%;
  min-height: 160rpx;
  font-size: 28rpx;
  color: #333333;
  border: 1rpx solid #e5e5e5;
  border-radius: 8rpx;
  padding: 20rpx;
  box-sizing: border-box;
}

/* 错误提示 */
.error-tip {
  font-size: 24rpx;
  color: #ef4444;
  margin-top: 8rpx;
}

/* 采集者显示区域 */
.collector-display {
  display: flex;
  align-items: flex-start;
  min-height: 60rpx;
  padding: 8rpx 0;
  flex-wrap: wrap;
}

.collector-tags {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.collector-tag {
  display: flex;
  align-items: center;
  padding: 10rpx 16rpx;
  background: linear-gradient(135deg, #f0fff4 0%, #e8f5e9 100%);
  border-radius: 36rpx;
  border: 2rpx solid #07c160;
  transition: all 0.2s ease;
}

.collector-tag:active {
  transform: scale(0.95);
}

.tag-avatar-wrapper {
  position: relative;
  margin-right: 12rpx;
}

.tag-avatar {
  width: 44rpx;
  height: 44rpx;
  border-radius: 22rpx;
}

.tag-online-dot {
  position: absolute;
  right: -2rpx;
  bottom: -2rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  border: 2rpx solid #ffffff;
}

.tag-online-dot.online {
  background-color: #07c160;
}

.tag-online-dot.offline {
  background-color: #cccccc;
}

.tag-name {
  font-size: 26rpx;
  color: #333333;
  font-weight: 500;
}

.tag-remove {
  width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 12rpx;
  background-color: rgba(7, 193, 96, 0.1);
  border-radius: 50%;
  font-size: 28rpx;
  color: #07c160;
  font-weight: bold;
}

.tag-remove:active {
  background-color: rgba(7, 193, 96, 0.2);
}

.collector-empty {
  flex: 1;
}

.collector-display .placeholder {
  font-size: 28rpx;
  color: #cccccc;
}

.collector-display .arrow {
  margin-left: 16rpx;
  align-self: center;
}

.selected-count {
  width: 100%;
  font-size: 24rpx;
  color: #07c160;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f9ff;
}

/* 提交容器 */
.submit-container {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background-color: #ffffff;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.08);
}

/* 提交按钮 */
.submit-btn {
  width: 100%;
  height: 90rpx;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 45rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.submit-btn[disabled] {
  background: #cccccc;
}

.gradient-btn {
  background: linear-gradient(135deg, #07c160 0%, #10b981 100%);
  color: #ffffff;
  border: none;
  font-weight: 600;
}

.gradient-btn::after {
  border: none;
}

/* 选择器遮罩层 */
.picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0);
  z-index: 1000;
  visibility: hidden;
  transition: all 0.3s ease;
}

.picker-mask.show {
  background-color: rgba(0, 0, 0, 0.5);
  visibility: visible;
}

/* 选择器内容 */
.picker-content {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  max-height: 70vh;
  transform: translateY(100%);
  transition: transform 0.3s ease;
  z-index: 1001;
}

.picker-content.show {
  transform: translateY(0);
}

.picker-content-wide {
  max-width: 100%;
}

/* 选择器头部 */
.picker-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  border-bottom: 1rpx solid #e5e5e5;
}

.header-left {
  display: flex;
  align-items: center;
}

.picker-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
}

.header-tip {
  font-size: 26rpx;
  color: #07c160;
  margin-left: 16rpx;
  padding: 6rpx 16rpx;
  background-color: #f0fff4;
  border-radius: 16rpx;
}

.picker-close {
  font-size: 50rpx;
  color: #cccccc;
  padding: 0 10rpx;
}

/* 选择器主体 */
.picker-body {
  padding: 20rpx 0;
  max-height: 60vh;
  overflow-y: auto;
}

/* 分类项 */
.category-item {
  display: flex;
  align-items: center;
  padding: 24rpx 30rpx;
  transition: background-color 0.2s;
}

.category-item:active {
  background-color: #f5f5f5;
}

.category-name {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
}

.category-check {
  font-size: 32rpx;
  color: #07c160;
  font-weight: bold;
}

/* 采集者列表 */
.collector-list {
  max-height: 45vh;
  overflow-y: auto;
  padding: 20rpx 30rpx;
}

.loading-tip,
.empty-tip {
  text-align: center;
  padding: 60rpx 0;
  font-size: 28rpx;
  color: #999999;
}

.collector-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background-color: #ffffff;
  border-radius: 20rpx;
  margin-bottom: 16rpx;
  border: 2rpx solid #e5e5e5;
  transition: all 0.25s ease;
}

.collector-item:active {
  transform: scale(0.98);
}

.collector-item.selected {
  border-color: #07c160;
  background: linear-gradient(135deg, #f0fff4 0%, #e8f5e9 100%);
  box-shadow: 0 4rpx 16rpx rgba(7, 193, 96, 0.15);
}

.collector-item .collector-avatar-wrapper {
  position: relative;
  margin-right: 20rpx;
}

.collector-item .collector-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 36rpx;
  border: 3rpx solid #f0f9ff;
}

.collector-item.selected .collector-avatar {
  border-color: #07c160;
}

.collector-item .online-indicator {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  border: 3rpx solid #ffffff;
}

.collector-item .online-indicator.online {
  background-color: #07c160;
}

.collector-item .online-indicator.offline {
  background-color: #cccccc;
}

.collector-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.info-main {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.collector-info .collector-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
  margin-right: 12rpx;
}

.collector-info .collector-role {
  font-size: 22rpx;
  color: #999999;
  padding: 4rpx 12rpx;
  background-color: #f5f5f5;
  border-radius: 10rpx;
}

.collector-info .collector-status {
  font-size: 24rpx;
}

.collector-info .collector-status.online {
  color: #07c160;
}

.collector-info .collector-status.offline {
  color: #999999;
}

.collector-check {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 26rpx;
  background-color: #e5e5e5;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: bold;
  transition: all 0.2s ease;
}

.collector-check.checked {
  background: linear-gradient(135deg, #07c160 0%, #10b981 100%);
  box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.3);
}

/* 选择器底部 */
.picker-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #e5e5e5;
  background-color: #ffffff;
}

.footer-info {
  font-size: 26rpx;
  color: #666666;
}

.footer-info text {
  color: #07c160;
  font-weight: 600;
}

.confirm-btn {
  min-width: 160rpx;
  height: 80rpx;
  background: #e5e5e5;
  color: #999999;
  font-size: 28rpx;
  font-weight: bold;
  border-radius: 40rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.confirm-btn.has-selection {
  background: linear-gradient(135deg, #07c160 0%, #10b981 100%);
  color: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(7, 193, 96, 0.3);
}

.confirm-btn::after {
  border: none;
}