var IMAGE_BASE_URL = 'http://10.197.211.192:8080';

function getFullUrl(url) {
  if (!url) return '';
  if (url.startsWith('http://') || url.startsWith('https://')) {
    return url;
  }
  return IMAGE_BASE_URL + url;
}

function getFirstImageUrl(item) {
  if (!item) return '';

  if (item.images && item.images.length > 0) {
    var firstImage = item.images[0];
    if (typeof firstImage === 'string') {
      return getFullUrl(firstImage);
    }
    return getFullUrl(firstImage.imageUrl || firstImage.url || '');
  }

  if (item.photos && item.photos.length > 0) {
    return getFullUrl(item.photos[0]);
  }

  return '';
}

module.exports = {
  getFullUrl: getFullUrl,
  getFirstImageUrl: getFirstImageUrl
};