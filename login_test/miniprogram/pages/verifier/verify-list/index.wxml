<!-- 核验列表页 -->
<!-- 功能：展示待核验的POI列表，支持分类筛选和排序 -->
<view class="container">

  <!-- 筛选工具栏 -->
  <view class="filter-toolbar">
    <!-- 分类筛选 -->
    <view class="filter-group">
      <text class="filter-label">分类</text>
      <scroll-view class="filter-scroll" scroll-x="true">
        <view class="filter-tags">
          <block wx:for="{{categoryOptions}}" wx:key="id">
            <view
              class="filter-tag {{filters.category === item.id ? 'active' : ''}}"
              data-category="{{item.id}}"
              bindtap="onCategoryChange"
            >
              <text class="tag-text">{{item.name}}</text>
            </view>
          </block>
        </view>
      </scroll-view>
    </view>

    <!-- 排序方式 -->
    <view class="filter-group">
      <text class="filter-label">排序</text>
      <scroll-view class="filter-scroll" scroll-x="true">
        <view class="filter-tags">
          <block wx:for="{{sortOptions}}" wx:key="id">
            <view
              class="filter-tag {{filters.sortBy === item.id ? 'active' : ''}}"
              data-sortby="{{item.id}}"
              bindtap="onSortChange"
            >
              <text class="tag-text">{{item.name}}</text>
            </view>
          </block>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- POI 列表 -->
  <view class="poi-list">
    <block wx:if="{{!isLoading && poiList.length > 0}}">
      <block wx:for="{{poiList}}" wx:key="id">
        <view
          class="poi-card"
          data-id="{{item.id}}"
          bindtap="onPOIClick"
        >
          <!-- 图片区域 -->
          <view class="poi-image-wrapper">
            <image
              class="poi-image"
              src="{{item.photos[0] || '/images/default-goods-image.png'}}"
              mode="aspectFill"
            />
            <!-- 分类标签 -->
            <view class="category-badge">
              <text class="category-text">{{item.categoryName}}</text>
            </view>
          </view>

          <!-- POI 信息 -->
          <view class="poi-info">
            <view class="poi-header">
              <text class="poi-name">{{item.name}}</text>
              <view class="priority-tag" wx:if="{{item.priority <= 2}}">
                <text class="priority-text">紧急</text>
              </view>
            </view>

            <view class="poi-address">
              <text class="address-text">{{item.address}}</text>
            </view>

            <view class="poi-meta">
              <text class="submit-time">提交时间：{{item.submitTime}}</text>
            </view>
          </view>

          <!-- 箭头 -->
          <view class="poi-arrow">
            <text class="arrow-icon">›</text>
          </view>
        </view>
      </block>

      <!-- 加载更多提示 -->
      <view class="load-more" wx:if="{{hasMore}}">
        <text class="load-more-text" bindtap="loadMore">加载更多</text>
      </view>

      <!-- 没有更多数据 -->
      <view class="no-more" wx:if="{{!hasMore && poiList.length > 0}}">
        <text class="no-more-text">没有更多数据了</text>
      </view>
    </block>

    <!-- 空状态 -->
    <block wx:elif="{{!isLoading && poiList.length === 0}}">
      <view class="empty-state">
        <image
          class="empty-icon"
          src="/images/icons/empty.png"
          mode="aspectFit"
        />
        <text class="empty-text">暂无待审核的POI</text>
      </view>
    </block>

    <!-- 加载状态 -->
    <block wx:if="{{isLoading}}">
      <view class="loading-state">
        <text class="loading-text">加载中...</text>
      </view>
    </block>
  </view>

</view>
