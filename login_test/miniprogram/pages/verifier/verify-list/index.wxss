/* 核验列表页样式 */

/* 页面容器 */
.container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background: #f6f6f6;
}

/* 筛选工具栏 */
.filter-toolbar {
  background: #fff;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.filter-group {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.filter-group:last-child {
  margin-bottom: 0;
}

.filter-label {
  font-size: 28rpx;
  color: #666;
  width: 80rpx;
  flex-shrink: 0;
}

.filter-scroll {
  flex: 1;
  white-space: nowrap;
}

.filter-tags {
  display: inline-flex;
  gap: 16rpx;
}

.filter-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 24rpx;
  background: #f0f0f0;
  border-radius: 24rpx;
  border: 2rpx solid transparent;
}

.filter-tag.active {
  background: #f0f7ff;
  border-color: #409eff;
}

.tag-text {
  font-size: 26rpx;
  color: #666;
}

.filter-tag.active .tag-text {
  color: #409eff;
}

/* POI 列表 */
.poi-list {
  flex: 1;
  padding: 0 20rpx;
}

/* POI 卡片 */
.poi-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.poi-image-wrapper {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  overflow: hidden;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.poi-image {
  width: 100%;
  height: 100%;
}

.category-badge {
  position: absolute;
  top: 0;
  left: 0;
  background: rgba(64, 158, 255, 0.9);
  padding: 4rpx 12rpx;
  border-radius: 12rpx 0 12rpx 0;
}

.category-text {
  font-size: 20rpx;
  color: #fff;
}

/* POI 信息 */
.poi-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.poi-header {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.poi-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.priority-tag {
  background: #fef0f0;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  margin-left: 12rpx;
  flex-shrink: 0;
}

.priority-text {
  font-size: 22rpx;
  color: #f56c6c;
}

.poi-address {
  margin-bottom: 8rpx;
}

.address-text {
  font-size: 26rpx;
  color: #666;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  display: block;
}

.poi-meta {
  display: flex;
  align-items: center;
}

.submit-time {
  font-size: 24rpx;
  color: #999;
}

/* 箭头 */
.poi-arrow {
  margin-left: 16rpx;
  flex-shrink: 0;
}

.arrow-icon {
  font-size: 48rpx;
  color: #ccc;
  font-weight: bold;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

/* 加载状态 */
.loading-state {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.loading-text {
  font-size: 28rpx;
  color: #409eff;
}

/* 加载更多 */
.load-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 30rpx 0;
}

.load-more-text {
  font-size: 28rpx;
  color: #409eff;
}

/* 没有更多 */
.no-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 30rpx 0;
}

.no-more-text {
  font-size: 26rpx;
  color: #999;
}
