/* 我的审核页样式 - 绿色主题配色系统 */

/* 页面容器 */
.container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background: linear-gradient(180deg, #f0fff4 0%, #f5f5f5 100%);
  padding: 20rpx;
}

/* 统计数据区域 */
.statistics-section {
  background: linear-gradient(135deg, #ffffff 0%, #f0fff4 100%);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(7, 193, 96, 0.08);
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
}

.statistics-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.stat-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx;
  background: #f9f9f9;
  border-radius: 12rpx;
}

.stat-card.success {
  background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%);
}

.stat-card.danger {
  background: linear-gradient(135deg, #fef2f2 0%, #fee2e2 100%);
}

.stat-card.warning {
  background: linear-gradient(135deg, #fffbeb 0%, #fef3c7 100%);
}

.stat-value {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.stat-card.success .stat-value {
  color: #67c23a;
}

.stat-card.danger .stat-value {
  color: #f56c6c;
}

.stat-card.warning .stat-value {
  color: #e6a23c;
}

.stat-label {
  font-size: 24rpx;
  color: #666;
}

/* 通过率图表 */
.rate-chart {
  position: relative;
  padding-top: 40rpx;
}

.chart-title {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.chart-bar {
  width: 100%;
  height: 24rpx;
  background: #f0f0f0;
  border-radius: 12rpx;
  overflow: hidden;
}

.chart-bar-fill {
  height: 100%;
  border-radius: 12rpx;
  transition: width 0.3s ease;
}

.chart-bar-fill.success {
  background: linear-gradient(to right, #67c23a, #85ce61);
}

.chart-percentage {
  position: absolute;
  top: 0;
  right: 0;
}

.percentage-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #67c23a;
}

/* 筛选工具栏 */
.filter-toolbar {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.filter-label {
  font-size: 28rpx;
  color: #666;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.filter-scroll {
  flex: 1;
  white-space: nowrap;
}

.filter-tags {
  display: inline-flex;
  gap: 16rpx;
}

.filter-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 24rpx;
  background: #f0f0f0;
  border-radius: 24rpx;
  border: 2rpx solid transparent;
}

.filter-tag.active {
  background: #f0fdf4;
  border-color: #07c160;
}

.tag-text {
  font-size: 26rpx;
  color: #666;
}

.filter-tag.active .tag-text {
  color: #07c160;
}

/* 审核记录列表 */
.review-list {
  flex: 1;
}

/* 审核记录卡片 */
.review-card {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

/* 审核结果标识 */
.result-badge {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.result-text {
  font-size: 28rpx;
  color: #fff;
  font-weight: 600;
  writing-mode: horizontal-tb;
}

/* POI 信息 */
.poi-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.poi-header {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.poi-name {
  flex: 1;
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 12rpx;
}

.category-tag {
  background: #f0fdf4;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.category-text {
  font-size: 22rpx;
  color: #07c160;
}

.review-time {
  margin-bottom: 8rpx;
}

.time-label {
  font-size: 24rpx;
  color: #999;
}

.time-value {
  font-size: 24rpx;
  color: #666;
}

/* 拒绝/不确定原因 */
.error-description {
  background: #fef9f9;
  padding: 12rpx;
  border-radius: 8rpx;
  margin-top: 8rpx;
}

.error-label {
  font-size: 24rpx;
  color: #f56c6c;
  font-weight: 500;
}

.error-text {
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
}

/* 箭头 */
.card-arrow {
  display: flex;
  align-items: center;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.arrow-icon {
  font-size: 48rpx;
  color: #ccc;
  font-weight: bold;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

/* 加载状态 */
.loading-state {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.loading-text {
  font-size: 28rpx;
  color: #07c160;
}

/* 加载更多 */
.load-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 30rpx 0;
}

.load-more-text {
  font-size: 28rpx;
  color: #07c160;
}

/* 没有更多 */
.no-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 30rpx 0;
}

.no-more-text {
  font-size: 26rpx;
  color: #999;
}
