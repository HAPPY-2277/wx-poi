<!-- 我的审核页 -->
<!-- 功能：展示核验者的审核记录和统计数据 -->
<view class="container">

  <!-- 统计数据卡片 -->
  <view class="statistics-section" wx:if="{{statistics.totalReviewed > 0}}">
    <view class="stat-card">
      <view class="stat-num">{{statistics.totalReviewed}}</view>
      <view class="stat-label">总审核数</view>
    </view>
    <view class="stat-card">
      <view class="stat-num success">{{statistics.approvedCount}}</view>
      <view class="stat-label">已通过</view>
    </view>
    <view class="stat-card">
      <view class="stat-num danger">{{statistics.rejectedCount}}</view>
      <view class="stat-label">已拒绝</view>
    </view>
    <view class="stat-card">
      <view class="stat-num warning">{{statistics.uncertainCount}}</view>
      <view class="stat-label">不确定</view>
    </view>
  </view>

  <!-- 通过率图表 -->
  <view class="rate-chart" wx:if="{{statistics.totalReviewed > 0}}">
    <view class="chart-title">审核通过率</view>
    <view class="chart-bar">
      <view
        class="chart-bar-fill success"
        style="width: {{approvedRate}}%;"
      />
    </view>
    <view class="chart-percentage">
      <text class="percentage-text">{{approvedRate}}%</text>
    </view>
  </view>

  <!-- 筛选工具栏 -->
  <view class="filter-toolbar" style="width: 670rpx; height: 104rpx; display: flex; box-sizing: border-box">
    <text class="filter-label">筛选</text>
    <view class="filter-options">
      <text
        wx:for="{{filterOptions}}"
        wx:key="id"
        class="filter-tag {{filters.result === item.id ? 'active' : ''}}"
        data-result="{{item.id}}"
        bindtap="onFilterChange"
      >{{item.name}}</text>
    </view>
  </view>

  <!-- 审核记录列表 -->
  <view class="review-list">
    <view
      class="review-card"
      wx:for="{{reviewList}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onReviewClick"
    >
      <view class="card-header">
        <text class="poi-name">{{item.poiName}}</text>
        <view class="result-badge" style="background-color: {{item.resultColor}};">
          <text class="result-text">{{item.resultText}}</text>
        </view>
      </view>

      <view class="card-body">
        <view class="info-row">
          <text class="info-label">分类</text>
          <text class="info-value">{{item.categoryName}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">审核时间</text>
          <text class="info-value">{{item.reviewTime}}</text>
        </view>
        <view class="info-row" wx:if="{{item.errorDescription}}">
          <text class="info-label">说明</text>
          <text class="info-value error">{{item.errorDescription}}</text>
        </view>
      </view>

      <view class="card-footer">
        <text class="view-detail">查看详情 ></text>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{!isLoading && reviewList.length === 0}}">
    <text class="empty-icon">📋</text>
    <text class="empty-text">暂无审核记录</text>
    <text class="empty-hint">快去审核POI数据吧</text>
  </view>

  <!-- 加载状态 -->
  <view class="loading-state" wx:if="{{isLoading}}">
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 没有更多数据 -->
  <view class="no-more" wx:if="{{!hasMore && reviewList.length > 0}}">
    <text class="no-more-text">没有更多数据了</text>
  </view>

</view>
