<view class="container">
  <view class="image-section">
    <swiper
      class="image-swiper"
      indicator-dots="true"
      indicator-color="rgba(255, 255, 255, 0.5)"
      indicator-active-color="#fff"
      autoplay="false"
      circular="true"
      bindchange="onImageSwiperChange"
    >
      <block wx:for="{{imageUrls}}" wx:key="index">
        <swiper-item>
          <image
            class="swiper-image"
            src="{{item}}"
            mode="aspectFill"
            data-index="{{index}}"
            bindtap="onImagePreview"
          />
        </swiper-item>
      </block>
    </swiper>
    <view class="image-indicator">
      <text class="indicator-text">{{currentImageIndex + 1}} / {{imageUrls.length}}</text>
    </view>
  </view>

  <view class="info-section">
    <view class="info-card">
      <view class="card-header">
        <text class="poi-name">{{submissionDetail.name}}</text>
        <view class="category-tag">
          <text class="category-text">{{submissionDetail.categoryName}}</text>
        </view>
      </view>

      <view class="info-row">
        <text class="info-label">地址</text>
        <text class="info-value">{{submissionDetail.address || '暂无'}}</text>
      </view>

      <view class="info-row">
        <text class="info-label">提交人</text>
        <text class="info-value">{{submissionDetail.submitter || submissionDetail.collectorName || '未知'}}</text>
      </view>

      <view class="info-row">
        <text class="info-label">提交时间</text>
        <text class="info-value">{{submissionDetail.submitTime || submissionDetail.createTime || '未知'}}</text>
      </view>

      <view class="info-row" wx:if="{{submissionDetail.description}}">
        <text class="info-label">描述</text>
        <text class="info-value description">{{submissionDetail.description}}</text>
      </view>

      <view class="map-button" bindtap="onViewMap" wx:if="{{submissionDetail.latitude}}">
        <text class="map-button-text">查看位置</text>
      </view>
    </view>

    <view class="action-section">
      <view class="section-title">审核操作</view>

      <view class="action-options">
        <block wx:for="{{actionOptions}}" wx:key="id">
          <view
            class="action-option {{selectedAction === item.id ? 'active' : ''}}"
            style="border-color: {{selectedAction === item.id ? item.color : 'transparent'}};"
            data-action="{{item.id}}"
            bindtap="onActionSelect"
          >
            <view class="action-icon" style="background-color: {{item.color}};">
              <text class="action-icon-text">{{item.icon}}</text>
            </view>
            <text class="action-label" style="color: {{selectedAction === item.id ? item.color : '#666'}}; width: 100rpx; display: block; box-sizing: border-box; height: 41rpx; text-align:   center">{{item.label}}</text>
          </view>
        </block>
      </view>

      <view class="error-description-wrapper" wx:if="{{showErrorDescription}}">
        <view class="input-label">拒绝原因</view>
        <textarea
          class="error-input"
          placeholder="请输入拒绝原因..."
          value="{{errorDescription}}"
          bindinput="onErrorDescriptionInput"
          maxlength="500"
        />
        <view class="input-hint">
          <text class="hint-text">{{errorDescription.length}} / 500</text>
        </view>
      </view>

      <button
        class="submit-button"
        bindtap="submitVerification"
        disabled="{{!selectedAction || isSubmitting}}"
      >
        <text class="submit-button-text">{{isSubmitting ? '提交中...' : '提交审核结果'}}</text>
      </button>
    </view>

    <view class="chat-section" wx:if="{{collectorId}}">
      <view class="section-title">异议处理</view>
      <view class="chat-actions">
        <button class="chat-btn" bindtap="onContactCollector">
          <text class="chat-btn-text">联系采集者</text>
        </button>
        <button class="objection-btn" bindtap="onSubmitObjection" wx:if="{{selectedAction === 'rejected' || selectedAction === 'uncertain'}}">
          <text class="chat-btn-text">提交异议</text>
        </button>
      </view>
      <view class="chat-hint">
        <text class="hint-info">无法达成共识时，可提交异议给第三方工作人员处理</text>
      </view>
    </view>
  </view>
</view>
