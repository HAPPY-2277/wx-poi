/* 聊天页面样式 - 绿色主题配色系统 */

.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, #f0fff4 0%, #f5f5f5 100%);
}

.login-tip {
  flex: 0 0 auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #ffffff 0%, #f0fff4 100%);
  margin: 0;
  border-radius: 0;
  padding: 120rpx 60rpx;
}

.tip-icon {
  font-size: 120rpx;
  margin-bottom: 40rpx;
}

.tip-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #1f2937;
  margin-bottom: 20rpx;
}

.tip-desc {
  font-size: 28rpx;
  color: #6b7280;
  margin-bottom: 60rpx;
}

.login-btn {
  width: 600rpx;
  height: 88rpx;
  background: linear-gradient(135deg, #07c160 0%, #10b981 100%);
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.3);
  margin: 0;
  padding: 0;
  border: none;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.login-btn::after {
  border: none;
}

.login-btn:active {
  transform: scale(0.96);
  box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.2);
}

.login-btn text {
  font-size: 32rpx;
  color: #ffffff;
  font-weight: bold;
}

.chat-wrapper {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: linear-gradient(180deg, #f0fff4 0%, #f5f5f5 100%);
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  background: linear-gradient(135deg, #07c160 0%, #10b981 50%, #06b5b7 100%);
  box-shadow: 0 4rpx 20rpx rgba(7, 193, 96, 0.25);
}

.header-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #ffffff;
}

.user-info {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.2);
  padding: 8rpx 16rpx 8rpx 8rpx;
  border-radius: 32rpx;
}

.avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, 0.5);
}

.nickname {
  font-size: 26rpx;
  color: #ffffff;
  margin-left: 12rpx;
}

.tab-bar {
  display: flex;
  background: linear-gradient(135deg, #ffffff 0%, #f0fff4 100%);
  padding: 0 16rpx;
  border-radius: 0 0 24rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(7, 193, 96, 0.1);
}

.tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 28rpx 0;
  position: relative;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  border-radius: 20rpx;
}

.tab-text {
  font-size: 28rpx;
  color: #6b7280;
  font-weight: 500;
  transition: all 0.3s ease;
}

.tab-item.active .tab-text {
  color: #07c160;
  font-weight: bold;
  font-size: 30rpx;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  background: linear-gradient(135deg, #07c160 0%, #10b981 100%);
  border-radius: 3rpx;
  box-shadow: 0 2rpx 8rpx rgba(7, 193, 96, 0.4);
}

.tab-badge {
  min-width: 36rpx;
  height: 36rpx;
  background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 10rpx;
  margin-left: 8rpx;
  box-shadow: 0 2rpx 8rpx rgba(239, 68, 68, 0.3);
}

.tab-badge text {
  font-size: 22rpx;
  color: #ffffff;
  font-weight: bold;
}

.content {
  flex: 1;
  overflow-y: auto;
  padding: 24rpx;
  width: 587rpx;
  box-sizing: border-box;
  display: block;
}

.section-wrapper {
  display: flex;
  flex-direction: column;
  min-height: 200rpx;
}

.section-title {
  font-size: 28rpx;
  color: #6b7280;
  font-weight: 600;
  padding: 0 8rpx;
  margin-bottom: 20rpx;
}

.section-content {
  display: flex;
  flex-direction: column;
}

.notification-item {
  display: flex;
  align-items: flex-start;
  padding: 28rpx;
  background: linear-gradient(135deg, #ffffff 0%, #f0fff4 100%);
  border-radius: 20rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(7, 193, 96, 0.08);
  position: relative;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.notification-item:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(7, 193, 96, 0.05);
}

.notification-icon {
  font-size: 52rpx;
  margin-right: 24rpx;
  background: linear-gradient(135deg, #fff3e0 0%, #ffe0b2 100%);
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.notification-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.notification-title {
  font-size: 30rpx;
  color: #1f2937;
  margin-bottom: 12rpx;
  line-height: 1.5;
  font-weight: 500;
}

.notification-time {
  font-size: 24rpx;
  color: #9ca3af;
}

.unread-dot {
  width: 16rpx;
  height: 16rpx;
  background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
  border-radius: 50%;
  box-shadow: 0 2rpx 8rpx rgba(239, 68, 68, 0.3);
  position: absolute;
  top: 28rpx;
  right: 28rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 60rpx;
  background: linear-gradient(135deg, #ffffff 0%, #f0fff4 100%);
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(7, 193, 96, 0.08);
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 32rpx;
  opacity: 0.6;
}

.empty-text {
  font-size: 30rpx;
  color: #1f2937;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.empty-hint {
  font-size: 26rpx;
  color: #6b7280;
  text-align: center;
  line-height: 1.6;
}

.chat-item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  background: linear-gradient(135deg, #ffffff 0%, #f0fff4 100%);
  border-radius: 20rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(7, 193, 96, 0.08);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.chat-item:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(7, 193, 96, 0.05);
}

.chat-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 24rpx;
  margin-right: 24rpx;
  background: linear-gradient(135deg, #e8f5e9 0%, #c8e6c9 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
}

.chat-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.chat-name {
  font-size: 32rpx;
  color: #1f2937;
  margin-bottom: 10rpx;
  font-weight: 600;
}

.chat-preview {
  font-size: 26rpx;
  color: #6b7280;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.chat-meta {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  margin-left: 16rpx;
}

.chat-time {
  font-size: 22rpx;
  color: #9ca3af;
  margin-bottom: 12rpx;
}

.unread-badge {
  min-width: 40rpx;
  height: 40rpx;
  background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(239, 68, 68, 0.3);
}

.unread-badge text {
  font-size: 24rpx;
  color: #ffffff;
  font-weight: bold;
}

.group-item {
  display: flex;
  align-items: center;
  padding: 32rpx;
  background: linear-gradient(135deg, #ffffff 0%, #f0fff4 100%);
  border-radius: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(7, 193, 96, 0.08);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.group-item:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(7, 193, 96, 0.05);
}

.group-item:last-child {
  margin-bottom: 0;
}

.group-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  margin-right: 28rpx;
  box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.1);
}

.group-icon.collector {
  background: linear-gradient(135deg, #e3f2fd 0%, #bbdefb 100%);
}

.group-icon.verifier {
  background: linear-gradient(135deg, #fce4ec 0%, #f8bbd9 100%);
}

.group-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.group-name {
  font-size: 34rpx;
  color: #1f2937;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.group-desc {
  font-size: 26rpx;
  color: #6b7280;
}

.group-arrow {
  font-size: 48rpx;
  color: #d1d5db;
  font-weight: 300;
}

/* 用户列表相关样式 */
.user-list-container {
  width: 100%;
}

.user-list {
  display: flex;
  flex-direction: column;
}

.user-card {
  display: flex;
  align-items: center;
  padding: 28rpx;
  background: linear-gradient(135deg, #ffffff 0%, #f0fff4 100%);
  border-radius: 20rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(7, 193, 96, 0.08);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.user-card:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(7, 193, 96, 0.05);
  background: linear-gradient(135deg, #f0fff4 0%, #e8f5e9 100%);
}

.user-avatar-wrapper {
  position: relative;
  margin-right: 24rpx;
}

.user-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  border: 4rpx solid #e8f5e9;
}

.user-status-dot {
  position: absolute;
  bottom: 4rpx;
  right: 4rpx;
  width: 24rpx;
  height: 24rpx;
  background: linear-gradient(135deg, #10b981 0%, #059669 100%);
  border-radius: 50%;
  border: 4rpx solid #ffffff;
  box-shadow: 0 2rpx 8rpx rgba(16, 185, 129, 0.4);
}

.user-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.user-name-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.user-name {
  font-size: 32rpx;
  color: #1f2937;
  font-weight: 600;
  margin-right: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 280rpx;
}

.user-role-tag {
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  min-width: 80rpx;
  text-align: center;
}

.user-role-tag text {
  font-size: 22rpx;
  color: #ffffff;
  font-weight: 500;
}

.user-meta {
  font-size: 24rpx;
  color: #9ca3af;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.user-action {
  margin-left: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-icon {
  font-size: 48rpx;
}

/* 加载状态样式 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 60rpx;
}

.loading-spinner {
  width: 80rpx;
  height: 80rpx;
  border: 6rpx solid #e5e7eb;
  border-top-color: #07c160;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 32rpx;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: #6b7280;
}

/* 错误状态样式 */
.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 60rpx;
  background: linear-gradient(135deg, #ffffff 0%, #fef2f2 100%);
  border-radius: 20rpx;
}

.error-icon {
  font-size: 80rpx;
  margin-bottom: 32rpx;
}

.error-text {
  font-size: 28rpx;
  color: #dc2626;
  margin-bottom: 40rpx;
  text-align: center;
}

.retry-btn {
  width: 240rpx;
  height: 72rpx;
  background: linear-gradient(135deg, #07c160 0%, #10b981 100%);
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(7, 193, 96, 0.3);
  margin: 0;
  padding: 0;
  border: none;
}

.retry-btn::after {
  border: none;
}

.retry-btn:active {
  transform: scale(0.96);
  box-shadow: 0 2rpx 8rpx rgba(7, 193, 96, 0.2);
}

.retry-btn text {
  font-size: 28rpx;
  color: #ffffff;
  font-weight: bold;
}