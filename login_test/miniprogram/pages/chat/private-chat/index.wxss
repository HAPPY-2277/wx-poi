.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f0f2f5;
}

.message-list {
  flex: 1;
  padding: 24rpx;
  overflow-y: auto;
  padding-bottom: 200rpx;
}

.loading-tip {
  text-align: center;
  padding: 24rpx;
  color: #999999;
  font-size: 26rpx;
}

.message-item {
  display: flex;
  flex-direction: column;
  margin-bottom: 32rpx;
  animation: fadeIn 0.3s ease;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.message-item.mine {
  align-items: flex-end;
}

.message-item.other {
  align-items: flex-start;
}

.message-header {
  margin-bottom: 12rpx;
  margin-left: 8rpx;
}

.sender-name {
  font-size: 26rpx;
  color: #07c160;
  font-weight: bold;
  background: rgba(7, 193, 96, 0.1);
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
}

.message-content {
  max-width: 70%;
  padding: 24rpx 32rpx;
  border-radius: 24rpx;
  word-break: break-word;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.message-item.mine .message-content {
  background: linear-gradient(135deg, #07c160 0%, #10b981 100%);
  color: #ffffff;
  border-bottom-right-radius: 8rpx;
}

.message-item.other .message-content {
  background: #ffffff;
  color: #333333;
  border-bottom-left-radius: 8rpx;
}

.message-text {
  font-size: 30rpx;
  line-height: 1.6;
}

.message-time {
  font-size: 22rpx;
  color: #bbbbbb;
  margin-top: 12rpx;
  padding: 0 12rpx;
}

.input-area {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background: linear-gradient(180deg, rgba(255,255,255,0.95) 0%, rgba(255,255,255,1) 100%);
  border-top: 1rpx solid rgba(0, 0, 0, 0.06);
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.message-input {
  flex: 1;
  height: 80rpx;
  padding: 0 32rpx;
  background: #f5f5f5;
  border-radius: 40rpx;
  font-size: 28rpx;
}

.send-btn {
  width: 120rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #07c160 0%, #10b981 100%);
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 20rpx;
  padding: 0;
  border: none;
  box-shadow: 0 4rpx 16rpx rgba(7, 193, 96, 0.3);
}

.send-btn::after {
  border: none;
}

.send-btn text {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: bold;
}