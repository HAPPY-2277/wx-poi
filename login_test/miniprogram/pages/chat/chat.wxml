<view class="container">
  <view class="login-tip" wx:if="{{!isLoggedIn}}">
    <view class="tip-icon">💬</view>
    <text class="tip-title">请先登录</text>
    <text class="tip-desc">登录后即可使用聊天功能</text>
    <button class="login-btn" bindtap="goToLogin">前往登录</button>
  </view>

  <view class="chat-wrapper" wx:else>
    <view class="header">
      <text class="header-title">消息中心</text>
      <view class="user-info" style="width: 353rpx; height: 105rpx; display: flex; box-sizing: border-box">
        <image class="avatar" src="{{userInfo.avatar}}" mode="aspectFill" />
        <text class="nickname">{{userInfo.nickname}}</text>
      </view>
    </view>

    <view class="tab-bar">
      <view class="tab-item {{activeTab === 'system' ? 'active' : ''}}" data-tab="system" bindtap="onTabChange">
        <text class="tab-text">系统通知</text>
        <view class="tab-badge" wx:if="{{systemUnreadCount > 0}}"><text>{{systemUnreadCount > 99 ? '99+' : systemUnreadCount}}</text></view>
      </view>
      <view class="tab-item {{activeTab === 'group' ? 'active' : ''}}" data-tab="group" bindtap="onTabChange">
        <text class="tab-text">群聊</text>
      </view>
      <view class="tab-item {{activeTab === 'users' ? 'active' : ''}}" data-tab="users" bindtap="onTabChange">
        <text class="tab-text">用户</text>
      </view>
    </view>

    <view class="content">
      <!-- 系统通知列表 -->
      <view class="system-list" wx:if="{{activeTab === 'system'}}">
        <block wx:if="{{systemNotifications.length > 0}}">
          <view class="notification-item" wx:for="{{systemNotifications}}" wx:key="msg_uuid" data-index="{{index}}" bindtap="onNotificationTap">
            <view class="notification-icon">📢</view>
            <view class="notification-content">
              <text class="notification-title">{{item.content}}</text>
              <text class="notification-time">{{item.created_at}}</text>
            </view>
            <view class="unread-dot" wx:if="{{item.is_read === 0}}"></view>
          </view>
        </block>
        <view class="empty-state" wx:else>
          <view class="empty-icon">🔔</view>
          <text class="empty-text">暂无系统通知</text>
          <text class="empty-hint">有新消息时会在此处显示</text>
        </view>
      </view>

      

      <!-- 群聊列表 -->
      <view class="group-list" wx:if="{{activeTab === 'group'}}">
        <view class="group-item" data-groupid="1" bindtap="onGroupChatTap">
          <view class="group-icon collector">👥</view>
          <view class="group-info">
            <text class="group-name">采集者交流群</text>
            <text class="group-desc">采集技巧、经验分享</text>
          </view>
          <text class="group-arrow">›</text>
        </view>
        <view class="group-item" data-groupid="2" bindtap="onGroupChatTap">
          <view class="group-icon verifier">🔍</view>
          <view class="group-info">
            <text class="group-name">核验者交流群</text>
            <text class="group-desc">核验标准、问题讨论</text>
          </view>
          <text class="group-arrow">›</text>
        </view>
      </view>

      <!-- 用户列表 -->
      <view class="user-list-container" wx:if="{{activeTab === 'users'}}">
        <!-- 加载状态 -->
        <view class="loading-state" wx:if="{{userListLoading}}">
          <view class="loading-spinner"></view>
          <text class="loading-text">加载用户列表...</text>
        </view>

        <!-- 错误状态 -->
        <view class="error-state" wx:elif="{{userListError}}">
          <view class="error-icon">⚠️</view>
          <text class="error-text">{{userListError}}</text>
          <button class="retry-btn" bindtap="onRetryUserList">重新加载</button>
        </view>

        <!-- 空状态 -->
        <view class="empty-state" wx:elif="{{userListEmpty}}">
          <view class="empty-icon">👥</view>
          <text class="empty-text">暂无用户</text>
          <text class="empty-hint">用户列表为空</text>
        </view>

        <!-- 用户列表 -->
        <block wx:elif="{{userList.length > 0}}">
          <view class="user-list">
            <view class="user-card" wx:for="{{userList}}" wx:key="userId" data-user="{{item}}" bindtap="onUserTap">
              <view class="user-avatar-wrapper">
                <image class="user-avatar" src="{{item.avatar}}" mode="aspectFill" />
                <view class="user-status-dot"></view>
              </view>
              <view class="user-info">
                <view class="user-name-row">
                  <text class="user-name">{{item.nickname}}</text>
                  <view class="user-role-tag" style="background: {{getRoleInfo(item.role).color}}">
                    <text>{{getRoleInfo(item.role).label}}</text>
                  </view>
                </view>
              </view>
              <view class="user-action">
                <text class="action-icon">💬</text>
              </view>
            </view>
          </view>
        </block>
      </view>
    </view>
  </view>
</view>