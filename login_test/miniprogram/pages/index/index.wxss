/* 页面容器 */
.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, #f8fafc 0%, #e8f5e9 100%);
  padding: 0 40rpx;
}

/* 已登录：个人中心样式 */
.profile-view {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
}

.profile-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx 60rpx;
  background: linear-gradient(135deg, #07c160 0%, #10b981 100%);
  border-radius: 0 0 48rpx 48rpx;
  margin-bottom: 40rpx;
}

.profile-avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 80rpx;
  border: 6rpx solid rgba(255, 255, 255, 0.8);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.2);
  margin-bottom: 24rpx;
}

.profile-info {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.profile-nickname {
  font-size: 40rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 16rpx;
}

.profile-role-badge {
  background: rgba(255, 255, 255, 0.25);
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
}

.role-text {
  font-size: 26rpx;
  color: #ffffff;
}

/* 功能菜单 */
.menu-section {
  background: #ffffff;
  border-radius: 24rpx;
  margin: 0 20rpx;
  padding: 16rpx 0;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 32rpx 40rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background: #f9f9f9;
}

.menu-icon {
  font-size: 40rpx;
  margin-right: 24rpx;
}

.menu-title {
  flex: 1;
  font-size: 32rpx;
  color: #333333;
}

.menu-arrow {
  font-size: 40rpx;
  color: #cccccc;
}

.logout-item .menu-title {
  color: #ff4d4f;
}

/* 版本信息 */
.footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
  margin-top: auto;
}

.footer-text {
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 8rpx;
}

.version {
  font-size: 22rpx;
  color: #cccccc;
}

/* 未登录：登录页面样式 */
.logo-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 120rpx;
  margin-bottom: 60rpx;
}

.logo-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.app-name {
  font-size: 52rpx;
  font-weight: bold;
  color: #1a1a1a;
  margin-bottom: 16rpx;
  letter-spacing: 4rpx;
}

.app-desc {
  font-size: 28rpx;
  color: #666;
  letter-spacing: 2rpx;
}

/* 登录区域 */
.login-section {
  flex: 1;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  padding-top: 80rpx;
}

.login-card {
  width: 100%;
  background: #fff;
  border-radius: 32rpx;
  padding: 60rpx 40rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
}

.login-title {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  text-align: center;
  margin-bottom: 16rpx;
}

.login-desc {
  display: block;
  font-size: 28rpx;
  color: #999;
  text-align: center;
  margin-bottom: 60rpx;
}

.login-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #07c160 0%, #06ad56 100%);
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.3);
  margin-bottom: 30rpx;
}

.login-btn::after {
  border: none;
}

.btn-text {
  font-size: 32rpx;
  color: #fff;
  font-weight: bold;
}

.login-btn:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.login-tip {
  display: block;
  font-size: 24rpx;
  color: #999;
  text-align: center;
  margin-top: 20rpx;
}