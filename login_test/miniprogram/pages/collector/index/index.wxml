<!-- 采集者首页 -->
<view class="container">

  <!-- 未登录提示视图 -->
  <view class="not-logged-in-view" wx:if="{{notLoggedIn}}">
    <view class="lock-icon">🔒</view>
    <text class="lock-title">登录后使用完整功能</text>
    <text class="lock-desc">请先在"个人"页面完成登录/注册操作</text>
    <button class="login-btn" bindtap="goToLogin">前往登录</button>
  </view>

  <!-- 已登录的采集者内容 -->
  <block wx:else>
  <!-- 角色头部信息 -->
  <view class="header" style="position: relative; left: -10rpx; top: 0rpx; width: 352rpx; height: 237rpx; display: block; box-sizing: border-box">
    <view class="user-info">
      <!-- 用户头像 -->
      <image class="avatar" src="{{userInfo.avatar}}" mode="aspectFill"></image>
      <view class="info">
        <text class="nickname">{{userInfo.nickname}}</text>
        <text class="role-tag">采集者</text>
      </view>
    </view>
    <view class="header-bg"></view>
  </view>

  <!-- 统计数据区域 -->
  <view class="stats-container" style="width: 577rpx; height: 237rpx; display: block; box-sizing: border-box">
    <view class="stats-card" style="width: 495rpx; height: 208rpx; display: flex; box-sizing: border-box">
      <!-- 新任务数 -->
      <view class="stat-item">
        <view class="stat-value">{{stats.newTasks}}</view>
        <view class="stat-label">新任务</view>
      </view>
      <view class="stat-divider"></view>
      <!-- 待处理任务数 -->
      <view class="stat-item" style="justify-self: center">
        <view class="stat-value">{{stats.pendingTasks}}</view>
        <view class="stat-label">待处理</view>
      </view>
      <view class="stat-divider"></view>
      <!-- 我的采集数 -->
      <view class="stat-item">
        <view class="stat-value">{{stats.myCollections}}</view>
        <view class="stat-label">已采集</view>
      </view>
    </view>
  </view>

  <!-- 功能入口区域 -->
  <view class="function-container" style="width: 650rpx; height: 693rpx; display: block; box-sizing: border-box">
    <view class="section-title">功能入口</view>
    <view class="function-grid">

      <!-- 新建采集 -->
      <view class="function-card" bindtap="onFunctionTap" data-id="new" data-path="{{functionList[0].path}}">
        <view class="card-icon new-icon">
          <image src="/images/icons/add.png" mode="aspectFit"></image>
        </view>
        <view class="card-content">
          <text class="card-title">{{functionList[0].title}}</text>
          <text class="card-desc">{{functionList[0].desc}}</text>
        </view>
      </view>

      <!-- 任务列表 -->
      <view class="function-card" bindtap="onFunctionTap" data-id="tasks" data-path="{{functionList[1].path}}">
        <view class="card-icon task-icon">
          <image src="/images/icons/task.png" mode="aspectFit"></image>
        </view>
        <view class="card-content">
          <text class="card-title">{{functionList[1].title}}</text>
          <text class="card-desc">{{functionList[1].desc}}</text>
        </view>
        <!-- 角标显示待处理任务数 -->
        <view class="badge" wx:if="{{functionList[1].badge > 0}}">
          {{functionList[1].badge > 99 ? '99+' : functionList[1].badge}}
        </view>
      </view>

      <!-- 我的采集 -->
      <view class="function-card" bindtap="onFunctionTap" data-id="my" data-path="{{functionList[2].path}}">
        <view class="card-icon my-icon">
          <image src="/images/icons/list.png" mode="aspectFit"></image>
        </view>
        <view class="card-content">
          <text class="card-title">{{functionList[2].title}}</text>
          <text class="card-desc">{{functionList[2].desc}}</text>
        </view>
      </view>

      <!-- 地图视图 -->
      <view class="function-card" bindtap="onFunctionTap" data-id="map" data-path="{{functionList[3].path}}">
        <view class="card-icon map-icon">
          <image src="/images/icons/map.png" mode="aspectFit"></image>
        </view>
        <view class="card-content">
          <text class="card-title">{{functionList[3].title}}</text>
          <text class="card-desc">{{functionList[3].desc}}</text>
        </view>
      </view>

    </view>
  </view>

  <!-- 加载状态 -->
  <view class="loading" wx:if="{{loading}}">
    <text>数据加载中...</text>
  </view>
  </block>

</view>
