<view class="container">
  <view class="stats-bar">
    <view class="stat-item">
      <text class="stat-value">{{stats.total}}</text>
      <text class="stat-label">总计</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-value approved">{{stats.approved}}</text>
      <text class="stat-label">已通过</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-value pending">{{stats.pending}}</text>
      <text class="stat-label">待审核</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-value rejected">{{stats.rejected}}</text>
      <text class="stat-label">已拒绝</text>
    </view>
  </view>

  <view class="filter-bar">
    <view class="filter-item {{filterStatus === 'all' ? 'active' : ''}}" bindtap="onFilterChange" data-status="all">全部</view>
    <view class="filter-item {{filterStatus === 'pending' ? 'active' : ''}}" bindtap="onFilterChange" data-status="pending">待审核</view>
    <view class="filter-item {{filterStatus === 'approved' ? 'active' : ''}}" bindtap="onFilterChange" data-status="approved">已通过</view>
    <view class="filter-item {{filterStatus === 'rejected' ? 'active' : ''}}" bindtap="onFilterChange" data-status="rejected">已拒绝</view>
    <view class="filter-item {{filterStatus === 'draft' ? 'active' : ''}}" bindtap="onFilterChange" data-status="draft">草稿</view>
  </view>

  <view class="poi-list">
    <view class="poi-item" wx:for="{{poiList}}" wx:key="id" bindtap="onPOITap" data-id="{{item.id}}">
      <view class="poi-image">
        <image wx:if="{{item.photos && item.photos.length > 0}}" src="{{item.photos[0]}}" mode="aspectFill"></image>
        <view wx:else class="no-image"><text>暂无图片</text></view>
        <view class="poi-status" style="background-color: {{getStatusInfo(item.status).color}}">{{getStatusInfo(item.status).icon}} {{getStatusInfo(item.status).label}}</view>
      </view>

      <view class="poi-content">
        <view class="poi-header">
          <text class="poi-name">{{item.name}}</text>
          <text class="poi-category" wx:if="{{item.categoryName}}">{{item.categoryName}}</text>
        </view>

        <view class="poi-address">
          <text class="address-icon">📍</text>
          <text class="address-text">{{item.address || '未提供地址'}}</text>
        </view>

        <view class="poi-reason" wx:if="{{item.status === 'rejected' && item.rejectReason}}">
          <text class="reason-icon">❗</text>
          <text class="reason-text">{{item.rejectReason}}</text>
        </view>

        <view class="poi-footer">
          <text class="poi-time">{{formatTime(item.createTime)}}</text>
          <view class="poi-actions" wx:if="{{item.status === 'draft'}}" catchtap="onDeleteDraft" data-id="{{item.id}}">
            <text class="action-btn delete">删除</text>
          </view>
        </view>
      </view>

      <view class="poi-arrow">›</view>
    </view>

    <view class="empty-state" wx:if="{{!loading && poiList.length === 0}}">
      <image class="empty-icon" src="/images/icons/empty.png" mode="aspectFit"></image>
      <text class="empty-text">暂无采集记录</text>
      <text class="empty-tip">开始采集第一个POI吧</text>
      <button class="start-collect-btn" bindtap="goToCollect">开始采集</button>
    </view>

    <view class="loading-more" wx:if="{{loading && poiList.length > 0}}"><text>加载中...</text></view>
    <view class="no-more" wx:if="{{!hasMore && poiList.length > 0}}"><text>没有更多了</text></view>
  </view>

  <view class="modal-mask" wx:if="{{showRecheckModal}}" bindtap="hideRecheckModal"></view>
  <view class="recheck-modal" wx:if="{{showRecheckModal}}">
    <view class="modal-title">复核操作</view>
    <view class="modal-poi-name">{{recheckPOI.name}}</view>
    
    <view class="recheck-options">
      <view class="recheck-option {{recheckAction === 'recollect' ? 'active' : ''}}" data-action="recollect" bindtap="onRecheckActionSelect">
        <text class="option-icon">🔄</text>
        <text class="option-text">重新采集</text>
      </view>
      <view class="recheck-option {{recheckAction === 'update' ? 'active' : ''}}" data-action="update" bindtap="onRecheckActionSelect">
        <text class="option-icon">✏️</text>
        <text class="option-text">更新数据</text>
      </view>
      <view class="recheck-option {{recheckAction === 'reject_recheck' ? 'active' : ''}}" data-action="reject_recheck" bindtap="onRecheckActionSelect">
        <text class="option-icon">⚠️</text>
        <text class="option-text">驳回</text>
      </view>
    </view>

    <textarea class="recheck-reason" placeholder="请输入处理说明..." value="{{recheckReason}}" bindinput="onRecheckReasonInput" maxlength="500"></textarea>

    <view class="modal-actions">
      <button class="modal-btn cancel" bindtap="hideRecheckModal">取消</button>
      <button class="modal-btn contact" bindtap="onContactVerifier">联系核验者</button>
      <button class="modal-btn submit" bindtap="onRecheckSubmit">确认</button>
    </view>
  </view>
</view>
