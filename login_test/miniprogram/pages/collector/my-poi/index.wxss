/* 我的采集列表页面样式 - 渐变多彩版（绿色主题兼容） */

/* 页面容器 */
.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #f0fff4 0%, #f5f5f5 100%);
}

/* 统计信息栏 - 渐变多彩卡片样式（绿色主题） */
.stats-bar {
  display: flex;
  background: linear-gradient(135deg, #07c160 0%, #10b981 50%, #06b5b7 100%);
  padding: 32rpx 16rpx;
  border-radius: 0 0 32rpx 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(7, 193, 96, 0.25);
  margin-top: 0;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

.stat-item:not(:last-child)::after {
  content: '';
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 1rpx;
  height: 50rpx;
  background: rgba(255, 255, 255, 0.3);
}

.stat-value {
  font-size: 42rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 8rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
}

.stat-value.approved {
  color: #a7f3d0;
  text-shadow: 0 2rpx 8rpx rgba(16, 185, 129, 0.4);
}

.stat-value.pending {
  color: #fde68a;
  text-shadow: 0 2rpx 8rpx rgba(245, 158, 11, 0.4);
}

.stat-value.rejected {
  color: #fecdd3;
  text-shadow: 0 2rpx 8rpx rgba(239, 68, 68, 0.4);
}

.stat-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  letter-spacing: 2rpx;
}

.stat-divider {
  display: none;
}

/* 筛选标签栏 - 胶囊式渐变风格（绿色主题） */
.filter-bar {
  display: flex;
  background-color: #ffffff;
  padding: 16rpx 24rpx;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  margin: 24rpx;
  gap: 12rpx;
}

.filter-item {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #666666;
  padding: 16rpx 8rpx;
  position: relative;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  border-radius: 20rpx;
}

.filter-item.active {
  color: #ffffff;
  font-weight: bold;
  background: linear-gradient(135deg, #07c160 0%, #10b981 100%);
  box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.35);
  transform: scale(1.02);
}

.filter-item:not(.active):active {
  background-color: #f0fff4;
}

/* POI列表 */
.poi-list {
  padding: 0 24rpx 24rpx;
}

/* POI项 - 渐变多彩卡片（绿色主题） */
.poi-item {
  background-color: #ffffff;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(7, 193, 96, 0.08);
  display: flex;
  overflow: hidden;
  position: relative;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.poi-item:active {
  transform: scale(0.98);
  box-shadow: 0 3rpx 10rpx rgba(7, 193, 96, 0.06);
}

/* 图片区域 */
.poi-image {
  width: 200rpx;
  height: 200rpx;
  position: relative;
  flex-shrink: 0;
}

.poi-image image {
  width: 100%;
  height: 100%;
  border-radius: 0;
}

.poi-item .poi-image image {
  border-radius: 20rpx 0 0 20rpx;
}

.no-image {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #f0fff4 0%, #dcfce7 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #6b7280;
}

/* 状态标签 */
.poi-status {
  position: absolute;
  bottom: 10rpx;
  left: 10rpx;
  padding: 6rpx 14rpx;
  color: #ffffff;
  font-size: 20rpx;
  border-radius: 20rpx;
  backdrop-filter: blur(8rpx);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
}

/* POI内容 */
.poi-content {
  flex: 1;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 160rpx;
}

.poi-header {
  margin-bottom: 8rpx;
}

.poi-name {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #1f2937;
  margin-bottom: 10rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.poi-category {
  display: inline-block;
  padding: 6rpx 14rpx;
  background: linear-gradient(135deg, #07c160 0%, #10b981 100%);
  color: #ffffff;
  font-size: 22rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

/* 地址 */
.poi-address {
  display: flex;
  align-items: flex-start;
  margin-bottom: 8rpx;
  flex: 1;
}

.address-icon {
  font-size: 24rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
}

.address-text {
  font-size: 24rpx;
  color: #6b7280;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* 拒绝原因 */
.poi-reason {
  background: linear-gradient(135deg, #fef2f2 0%, #fee2e2 100%);
  border-left: 4rpx solid #ef4444;
  padding: 12rpx;
  margin-bottom: 8rpx;
  border-radius: 0 12rpx 12rpx 0;
  display: flex;
  align-items: flex-start;
}

.reason-icon {
  margin-right: 8rpx;
  flex-shrink: 0;
}

.reason-text {
  font-size: 22rpx;
  color: #dc2626;
  line-height: 1.4;
}

/* POI底部信息 */
.poi-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: auto;
  padding-top: 8rpx;
}

.poi-time {
  font-size: 22rpx;
  color: #9ca3af;
}

/* 操作按钮 */
.poi-actions {
  display: flex;
  align-items: center;
}

.action-btn {
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  margin-left: 12rpx;
  transition: all 0.2s ease;
}

.action-btn.delete {
  color: #e53e3e;
  background: linear-gradient(135deg, #fef2f2 0%, #fee2e2 100%);
}

.action-btn.delete:active {
  transform: scale(0.95);
}

/* 箭头指示 */
.poi-arrow {
  position: absolute;
  right: 16rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 36rpx;
  color: #d1d5db;
  font-weight: 300;
}

/* 空状态 - 渐变多彩风格（绿色主题） */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  width: 220rpx;
  height: 220rpx;
  margin-bottom: 32rpx;
  opacity: 0.7;
  filter: drop-shadow(0 8rpx 16rpx rgba(7, 193, 96, 0.15));
}

.empty-text {
  font-size: 34rpx;
  color: #1f2937;
  margin-bottom: 16rpx;
  font-weight: 600;
}

.empty-tip {
  font-size: 26rpx;
  color: #6b7280;
  margin-bottom: 48rpx;
}

/* 开始采集按钮 - 渐变胶囊风格（绿色主题） */
.start-collect-btn {
  width: 320rpx;
  height: 88rpx;
  background: linear-gradient(135deg, #07c160 0%, #10b981 100%);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: bold;
  border: none;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.3);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.start-collect-btn::after {
  border: none;
}

.start-collect-btn:active {
  transform: scale(0.96);
  box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.2);
}

/* 加载更多 */
.loading-more {
  text-align: center;
  padding: 32rpx;
  color: #6b7280;
  font-size: 26rpx;
}

/* 没有更多数据 */
.no-more {
  text-align: center;
  padding: 32rpx;
  color: #d1d5db;
  font-size: 26rpx;
}

/* 弹窗遮罩 - 渐变渐显 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.5) 0%, rgba(0, 0, 0, 0.7) 100%);
  z-index: 1000;
  animation: fadeIn 0.3s ease;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

/* 复核弹窗 - 渐变多彩风格（绿色主题） */
.recheck-modal {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: linear-gradient(180deg, #ffffff 0%, #f0fff4 100%);
  border-radius: 32rpx 32rpx 0 0;
  padding: 48rpx 32rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  z-index: 1001;
  animation: slideUp 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  box-shadow: 0 -8rpx 32rpx rgba(7, 193, 96, 0.12);
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.modal-title {
  font-size: 38rpx;
  font-weight: bold;
  color: #1f2937;
  text-align: center;
  margin-bottom: 12rpx;
}

.modal-poi-name {
  font-size: 28rpx;
  color: #6b7280;
  text-align: center;
  margin-bottom: 36rpx;
}

.recheck-options {
  display: flex;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.recheck-option {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 28rpx 16rpx;
  background: linear-gradient(135deg, #f0fff4 0%, #dcfce7 100%);
  border-radius: 20rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.recheck-option.active {
  border-color: #07c160;
  background: linear-gradient(135deg, #dcfce7 0%, #bbf7d0 100%);
  box-shadow: 0 4rpx 16rpx rgba(7, 193, 96, 0.2);
  transform: scale(1.02);
}

.option-icon {
  font-size: 52rpx;
  margin-bottom: 12rpx;
}

.option-text {
  font-size: 26rpx;
  color: #374151;
  font-weight: 500;
}

.recheck-reason {
  width: 100%;
  min-height: 160rpx;
  background: linear-gradient(135deg, #f0fff4 0%, #dcfce7 100%);
  border-radius: 20rpx;
  padding: 24rpx;
  font-size: 28rpx;
  color: #1f2937;
  box-sizing: border-box;
  margin-bottom: 32rpx;
  border: 1rpx solid #d1fae5;
  transition: all 0.2s ease;
}

.recheck-reason:focus {
  border-color: #07c160;
  box-shadow: 0 0 0 4rpx rgba(7, 193, 96, 0.1);
}

.modal-actions {
  display: flex;
  gap: 16rpx;
}

.modal-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  margin: 0;
  padding: 0;
  border: none;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.modal-btn::after {
  border: none;
}

.modal-btn:active {
  transform: scale(0.96);
}

.modal-btn.cancel {
  background: linear-gradient(135deg, #f0fff4 0%, #dcfce7 100%);
  color: #6b7280;
}

.modal-btn.contact {
  background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);
  color: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(245, 158, 11, 0.3);
}

.modal-btn.submit {
  background: linear-gradient(135deg, #07c160 0%, #10b981 100%);
  color: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.3);
}
