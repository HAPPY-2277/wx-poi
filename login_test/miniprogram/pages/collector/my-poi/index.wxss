/* 我的采集列表页面样式 */

/* 页面容器 */
.container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

/* 统计信息栏 */
.stats-bar {
  display: flex;
  background-color: #ffffff;
  padding: 30rpx 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 8rpx;
}

.stat-value.approved {
  color: #10b981;
}

.stat-value.pending {
  color: #f59e0b;
}

.stat-value.rejected {
  color: #ef4444;
}

.stat-label {
  font-size: 24rpx;
  color: #999999;
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background-color: #e5e5e5;
}

/* 筛选标签栏 */
.filter-bar {
  display: flex;
  background-color: #ffffff;
  padding: 20rpx 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  position: sticky;
  top: 0;
  z-index: 100;
  margin-top: 20rpx;
}

.filter-item {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #666666;
  padding: 16rpx 0;
  position: relative;
  transition: all 0.3s ease;
}

.filter-item.active {
  color: #07c160;
  font-weight: bold;
}

.filter-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 4rpx;
  background-color: #07c160;
  border-radius: 2rpx;
}

/* POI列表 */
.poi-list {
  padding: 24rpx;
}

/* POI项 */
.poi-item {
  background-color: #ffffff;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  display: flex;
  overflow: hidden;
  position: relative;
  transition: all 0.3s ease;
}

.poi-item:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

/* 图片区域 */
.poi-image {
  width: 220rpx;
  height: 220rpx;
  position: relative;
  flex-shrink: 0;
}

.poi-image image {
  width: 100%;
  height: 100%;
}

.no-image {
  width: 100%;
  height: 100%;
  background-color: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #cccccc;
}

/* 状态标签 */
.poi-status {
  position: absolute;
  bottom: 10rpx;
  left: 10rpx;
  padding: 6rpx 12rpx;
  color: #ffffff;
  font-size: 20rpx;
  border-radius: 20rpx;
}

/* POI内容 */
.poi-content {
  flex: 1;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.poi-header {
  margin-bottom: 12rpx;
}

.poi-name {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.poi-category {
  display: inline-block;
  padding: 4rpx 12rpx;
  background-color: #f0f9f4;
  color: #07c160;
  font-size: 22rpx;
  border-radius: 16rpx;
}

/* 地址 */
.poi-address {
  display: flex;
  align-items: flex-start;
  margin-bottom: 12rpx;
  flex: 1;
}

.address-icon {
  font-size: 24rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
}

.address-text {
  font-size: 24rpx;
  color: #666666;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* 拒绝原因 */
.poi-reason {
  background-color: #fef2f2;
  border-left: 4rpx solid #ef4444;
  padding: 12rpx;
  margin-bottom: 12rpx;
  border-radius: 0 8rpx 8rpx 0;
  display: flex;
  align-items: flex-start;
}

.reason-icon {
  margin-right: 8rpx;
  flex-shrink: 0;
}

.reason-text {
  font-size: 22rpx;
  color: #dc2626;
  line-height: 1.4;
}

/* POI底部信息 */
.poi-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: auto;
  padding-top: 12rpx;
}

.poi-time {
  font-size: 22rpx;
  color: #999999;
}

/* 操作按钮 */
.poi-actions {
  display: flex;
  align-items: center;
}

.action-btn {
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  margin-left: 12rpx;
}

.action-btn.delete {
  color: #ef4444;
  background-color: #fef2f2;
}

/* 箭头指示 */
.poi-arrow {
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 40rpx;
  color: #cccccc;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 32rpx;
  color: #333333;
  margin-bottom: 16rpx;
}

.empty-tip {
  font-size: 26rpx;
  color: #999999;
  margin-bottom: 40rpx;
}

/* 开始采集按钮 */
.start-collect-btn {
  width: 300rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #07c160 0%, #10b981 100%);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: bold;
  border: none;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.start-collect-btn::after {
  border: none;
}

/* 加载更多 */
.loading-more {
  text-align: center;
  padding: 30rpx;
  color: #999999;
  font-size: 26rpx;
}

/* 没有更多数据 */
.no-more {
  text-align: center;
  padding: 30rpx;
  color: #cccccc;
  font-size: 26rpx;
}

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
}

.recheck-modal {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx 30rpx;
  z-index: 1001;
}

.modal-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333333;
  text-align: center;
  margin-bottom: 20rpx;
}

.modal-poi-name {
  font-size: 28rpx;
  color: #666666;
  text-align: center;
  margin-bottom: 30rpx;
}

.recheck-options {
  display: flex;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.recheck-option {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30rpx 20rpx;
  background: #f5f5f5;
  border-radius: 16rpx;
  border: 2rpx solid transparent;
}

.recheck-option.active {
  border-color: #07c160;
  background: #f0fff4;
}

.option-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.option-text {
  font-size: 26rpx;
  color: #333333;
}

.recheck-reason {
  width: 100%;
  min-height: 160rpx;
  background: #f5f5f5;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 28rpx;
  color: #333333;
  box-sizing: border-box;
  margin-bottom: 30rpx;
}

.modal-actions {
  display: flex;
  gap: 20rpx;
}

.modal-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  margin: 0;
  padding: 0;
  border: none;
}

.modal-btn::after {
  border: none;
}

.modal-btn.cancel {
  background: #f5f5f5;
  color: #666666;
}

.modal-btn.contact {
  background: #e6a23c;
  color: #ffffff;
}

.modal-btn.submit {
  background: #07c160;
  color: #ffffff;
}
