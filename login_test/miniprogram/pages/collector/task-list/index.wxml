<!-- 任务列表页面 -->
<view class="container">

  <!-- 筛选标签栏 -->
  <view class="filter-bar" style="position: sticky; left: NaNrpx; top: 0rpx; width: 599rpx; height: 125rpx; display: flex; box-sizing: border-box">
    <view
      class="filter-item {{filterStatus === 'all' ? 'active' : ''}}"
      bindtap="onFilterChange"
      data-status="all"
    >
      全部
    </view>
    <view
      class="filter-item {{filterStatus === 'PENDING_COLLECTION' ? 'active' : ''}}"
      bindtap="onFilterChange"
      data-status="PENDING_COLLECTION"
    >
      待采集
    </view>
    <view
      class="filter-item {{filterStatus === 'PENDING_REVIEW' ? 'active' : ''}}"
      bindtap="onFilterChange"
      data-status="PENDING_REVIEW"
    >
      审核中
    </view>
    <view
      class="filter-item {{filterStatus === 'COMPLETED' ? 'active' : ''}}"
      bindtap="onFilterChange"
      data-status="COMPLETED"
    >
      已完成
    </view>
  </view>

  <!-- 任务列表 -->
  <view class="task-list">

    <!-- 任务项 -->
    <view
      class="task-item"
      wx:for="{{taskList}}"
      wx:key="id"
    >
      <!-- 任务状态标签 -->
      <view class="task-status" style="background-color: {{getStatusInfo(item.status).color}}">
        {{getStatusInfo(item.status).label}}
      </view>

      <!-- 任务内容 -->
      <view class="task-content">
        <view class="task-header">
          <!-- 任务类型 -->
          <text class="task-type">{{item.taskType === 'CREATE_NEW' ? '新POI采集' : 'POI更新'}}</text>
          <!-- 发布时间 -->
          <text class="task-time">{{formatTime(item.createdAt)}}</text>
        </view>

        <!-- 任务目标名称 -->
        <view class="task-name" wx:if="{{item.targetName}}">
          {{item.targetName}}
        </view>

        <!-- 任务描述 -->
        <view class="task-desc">
          <text wx:if="{{item.targetAddress}}">{{item.targetAddress}}</text>
          <text wx:else>未提供地址信息</text>
        </view>

        <!-- 重新采集原因 -->
        <view class="task-reason" wx:if="{{item.description && item.status === 'PENDING_COLLECTION'}}">
          <text class="reason-label">任务描述：</text>
          <text class="reason-text">{{item.description}}</text>
        </view>

        <!-- 任务底部信息 -->
        <view class="task-footer">
          <!-- 分类标签 -->
          <view class="task-category" wx:if="{{item.targetCategory}}">
            <text class="category-tag">{{getCategoryName(item.targetCategory)}}</text>
          </view>

          <!-- 分配人数 -->
          <view class="assignee-count" wx:if="{{item.assigneeCount}}">
            <text>已分配 {{item.assigneeCount}} 人</text>
          </view>
        </view>
      </view>

      <!-- 操作按钮区域 -->
      <view class="task-actions">
        <!-- Navigate 按钮 -->
        <view
          class="action-btn navigate-btn"
          bindtap="onNavigate"
          data-task="{{item}}"
          wx:if="{{item.targetLongitude && item.targetLatitude}}"
        >
          <text class="btn-icon">📍</text>
          <text class="btn-text">导航</text>
        </view>

        <!-- Submit 按钮 -->
        <view
          class="action-btn submit-btn {{item.status !== 'PENDING_COLLECTION' ? 'disabled' : ''}}"
          bindtap="onSubmit"
          data-task="{{item}}"
          data-taskid="{{item.id}}"
        >
          <text class="btn-icon">✏️</text>
          <text class="btn-text">{{item.status === 'PENDING_COLLECTION' ? '提交' : (item.status === 'PENDING_REVIEW' ? '审核中' : '已完成')}}</text>
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{!loading && taskList.length === 0}}">
      <image class="empty-icon" src="/images/icons/empty.png" mode="aspectFit"></image>
      <text class="empty-text">暂无任务</text>
      <text class="empty-tip">当前筛选条件下没有待采集的任务</text>
    </view>

    <!-- 加载更多 -->
    <view class="loading-more" wx:if="{{loading && taskList.length > 0}}">
      <text>加载中...</text>
    </view>

    <!-- 没有更多数据 -->
    <view class="no-more" wx:if="{{!hasMore && taskList.length > 0}}">
      <text>没有更多了</text>
    </view>

  </view>

</view>