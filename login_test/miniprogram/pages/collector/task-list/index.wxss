/* 任务列表页面样式 */

/* 页面容器 */
.container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

/* 筛选标签栏 */
.filter-bar {
  display: flex;
  background-color: #ffffff;
  padding: 20rpx 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  position: sticky;
  top: 0;
  z-index: 100;
}

.filter-item {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #666666;
  padding: 16rpx 0;
  position: relative;
  transition: all 0.3s ease;
}

.filter-item.active {
  color: #07c160;
  font-weight: bold;
}

.filter-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 4rpx;
  background-color: #07c160;
  border-radius: 2rpx;
}

/* 任务列表 */
.task-list {
  padding: 24rpx;
}

/* 任务项 */
.task-item {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  display: flex;
  align-items: flex-start;
  position: relative;
  transition: all 0.3s ease;
}

.task-item:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

/* 任务状态标签 */
.task-status {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  padding: 6rpx 16rpx;
  color: #ffffff;
  font-size: 22rpx;
  border-radius: 20rpx;
}

/* 任务内容 */
.task-content {
  flex: 1;
  margin-right: 40rpx;
}

.task-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.task-type {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
}

.task-time {
  font-size: 24rpx;
  color: #999999;
}

/* 任务描述 */
.task-desc {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.5;
  margin-bottom: 16rpx;
}

/* 重新采集原因 */
.task-reason {
  background-color: #fef3cd;
  border-left: 4rpx solid #ffc107;
  padding: 16rpx;
  margin-bottom: 16rpx;
  border-radius: 0 8rpx 8rpx 0;
}

.reason-label {
  font-size: 24rpx;
  color: #856404;
  font-weight: bold;
  margin-right: 8rpx;
}

.reason-text {
  font-size: 24rpx;
  color: #856404;
  line-height: 1.5;
}

/* 任务底部信息 */
.task-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 24rpx;
}

.task-priority {
  display: flex;
  align-items: center;
}

.priority-label {
  color: #999999;
}

.priority-value {
  color: #666666;
}

.priority-value.high {
  color: #ef4444;
  font-weight: bold;
}

.task-deadline {
  color: #999999;
}

/* 箭头指示 */
.task-arrow {
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 40rpx;
  color: #cccccc;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 32rpx;
  color: #333333;
  margin-bottom: 16rpx;
}

.empty-tip {
  font-size: 26rpx;
  color: #999999;
}

/* 加载更多 */
.loading-more {
  text-align: center;
  padding: 30rpx;
  color: #999999;
  font-size: 26rpx;
}

/* 没有更多数据 */
.no-more {
  text-align: center;
  padding: 30rpx;
  color: #cccccc;
  font-size: 26rpx;
}
