/* 任务列表页面样式 - 绿色主题配色系统 */

/* 页面容器 */
.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #f0fff4 0%, #f5f5f5 100%);
}

/* 筛选标签栏 */
.filter-bar {
  display: flex;
  background: linear-gradient(135deg, #ffffff 0%, #f0fff4 100%);
  padding: 20rpx 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(7, 193, 96, 0.08);
  position: sticky;
  top: 0;
  z-index: 100;
  border-radius: 0 0 24rpx 24rpx;
}

.filter-item {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #666666;
  padding: 16rpx 0;
  position: relative;
  transition: all 0.3s ease;
}

.filter-item.active {
  color: #07c160;
  font-weight: bold;
}

.filter-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 4rpx;
  background-color: #07c160;
  border-radius: 2rpx;
}

/* 任务列表 */
.task-list {
  padding: 24rpx;
}

/* 任务项 */
.task-item {
  background: linear-gradient(135deg, #ffffff 0%, #f0fff4 100%);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(7, 193, 96, 0.08);
  display: flex;
  flex-direction: column;
  position: relative;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.task-item:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(7, 193, 96, 0.05);
}

/* 任务状态标签 */
.task-status {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  padding: 6rpx 16rpx;
  color: #ffffff;
  font-size: 22rpx;
  border-radius: 20rpx;
}

/* 任务内容 */
.task-content {
  flex: 1;
  padding-right: 200rpx;
}

.task-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.task-type {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
}

.task-time {
  font-size: 24rpx;
  color: #999999;
}

/* 任务目标名称 */
.task-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #1f2937;
  margin-bottom: 12rpx;
}

/* 任务描述 */
.task-desc {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.5;
  margin-bottom: 16rpx;
}

/* 重新采集原因 */
.task-reason {
  background-color: #fef3cd;
  border-left: 4rpx solid #ffc107;
  padding: 16rpx;
  margin-bottom: 16rpx;
  border-radius: 0 8rpx 8rpx 0;
}

.reason-label {
  font-size: 24rpx;
  color: #856404;
  font-weight: bold;
  margin-right: 8rpx;
}

.reason-text {
  font-size: 24rpx;
  color: #856404;
  line-height: 1.5;
}

/* 任务底部信息 */
.task-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 24rpx;
}

.task-category {
  display: flex;
  align-items: center;
}

.category-tag {
  display: inline-block;
  padding: 4rpx 12rpx;
  background-color: #e8f5e9;
  color: #07c160;
  font-size: 22rpx;
  border-radius: 12rpx;
}

.assignee-count {
  color: #999999;
}

/* 操作按钮区域 */
.task-actions {
  display: flex;
  flex-direction: column;
  position: absolute;
  right: 24rpx;
  bottom: 30rpx;
  gap: 16rpx;
}

/* 操作按钮样式 */
.action-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 24rpx;
  border-radius: 24rpx;
  min-width: 120rpx;
  transition: all 0.2s ease;
}

.action-btn:active {
  transform: scale(0.95);
  opacity: 0.8;
}

/* 导航按钮 */
.navigate-btn {
  background: linear-gradient(135deg, #ffffff 0%, #f0f9ff 100%);
  border: 2rpx solid #3b82f6;
}

.navigate-btn .btn-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.navigate-btn .btn-text {
  font-size: 26rpx;
  color: #3b82f6;
  font-weight: 600;
}

/* 提交按钮 */
.submit-btn {
  background: linear-gradient(135deg, #07c160 0%, #10b981 100%);
  color: #ffffff;
}

.submit-btn .btn-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.submit-btn .btn-text {
  font-size: 26rpx;
  font-weight: 600;
}

/* 禁用状态按钮 */
.action-btn.disabled {
  background: linear-gradient(135deg, #e5e5e5 0%, #d4d4d4 100%);
  border: 2rpx solid #d4d4d4;
}

.action-btn.disabled .btn-text {
  color: #999999;
}

.navigate-btn.disabled {
  opacity: 0.5;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 32rpx;
  color: #333333;
  margin-bottom: 16rpx;
}

.empty-tip {
  font-size: 26rpx;
  color: #999999;
}

/* 加载更多 */
.loading-more {
  text-align: center;
  padding: 30rpx;
  color: #999999;
  font-size: 26rpx;
}

/* 没有更多数据 */
.no-more {
  text-align: center;
  padding: 30rpx;
  color: #cccccc;
  font-size: 26rpx;
}