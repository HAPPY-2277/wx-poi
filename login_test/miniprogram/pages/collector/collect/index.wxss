/* 采集表单页面样式 */

/* 页面容器 */
.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 120rpx;
}

/* 表单区域 */
.form-container {
  padding: 30rpx;
}

/* 表单项 */
.form-item {
  background-color: #ffffff;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.form-item.error {
  border: 2rpx solid #ef4444;
}

/* 表单标签 */
.form-label {
  font-size: 28rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 16rpx;
}

.required {
  color: #ef4444;
  margin-left: 4rpx;
}

/* 输入框 */
.form-input {
  width: 100%;
  height: 80rpx;
  font-size: 28rpx;
  color: #333333;
  border: 1rpx solid #e5e5e5;
  border-radius: 8rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
}

/* 多行文本框 */
.form-textarea {
  width: 100%;
  min-height: 160rpx;
  font-size: 28rpx;
  color: #333333;
  border: 1rpx solid #e5e5e5;
  border-radius: 8rpx;
  padding: 20rpx;
  box-sizing: border-box;
}

/* 选择项显示 */
.form-value {
  height: 80rpx;
  font-size: 28rpx;
  color: #333333;
  border: 1rpx solid #e5e5e5;
  border-radius: 8rpx;
  padding: 0 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.form-value.placeholder {
  color: #cccccc;
}

.arrow {
  font-size: 32rpx;
  color: #cccccc;
}

/* 错误提示 */
.error-tip {
  font-size: 24rpx;
  color: #ef4444;
  margin-top: 8rpx;
}

/* GPS位置容器 */
.location-container {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.location-info {
  flex: 1;
  margin-right: 20rpx;
}

.location-text {
  font-size: 26rpx;
  color: #333333;
  word-break: break-all;
}

.location-placeholder {
  font-size: 26rpx;
  color: #cccccc;
}

/* 位置按钮 */
.location-btn {
  width: 220rpx;
  height: 70rpx;
  font-size: 26rpx;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 0;
}

.gradient-btn {
  background: linear-gradient(135deg, #07c160 0%, #10b981 100%);
  color: #ffffff;
  border: none;
  font-weight: 600;
}

.gradient-btn::after {
  border: none;
}

/* 图片容器 */
.photo-container {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

/* 图片项 */
.photo-item {
  width: 200rpx;
  height: 200rpx;
  position: relative;
  border-radius: 8rpx;
  overflow: hidden;
}

.photo-item image {
  width: 100%;
  height: 100%;
}

/* 删除按钮 */
.delete-btn {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  background-color: rgba(0, 0, 0, 0.6);
  color: #ffffff;
  font-size: 32rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 添加图片按钮 */
.add-photo {
  width: 200rpx;
  height: 200rpx;
  background-color: #f5f5f5;
  border: 2rpx dashed #cccccc;
  border-radius: 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.add-icon {
  font-size: 60rpx;
  color: #cccccc;
  margin-bottom: 8rpx;
}

.add-text {
  font-size: 24rpx;
  color: #999999;
}

/* 图片提示 */
.photo-tip {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #999999;
}

/* 提交容器 */
.submit-container {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background-color: #ffffff;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.08);
}

/* 提交按钮 */
.submit-btn {
  width: 100%;
  height: 90rpx;
  background: linear-gradient(135deg, #07c160 0%, #10b981 100%);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: bold;
  border: none;
  border-radius: 45rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.submit-btn::after {
  border: none;
}

.submit-btn[disabled] {
  background: #cccccc;
}

/* 分类选择器遮罩层 */
.picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0);
  z-index: 1000;
  visibility: hidden;
  transition: all 0.3s ease;
}

.picker-mask.show {
  background-color: rgba(0, 0, 0, 0.5);
  visibility: visible;
}

/* 分类选择器内容 */
.picker-content {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  max-height: 70vh;
  transform: translateY(100%);
  transition: transform 0.3s ease;
  z-index: 1001;
}

.picker-content.show {
  transform: translateY(0);
}

/* 选择器头部 */
.picker-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  border-bottom: 1rpx solid #e5e5e5;
}

.picker-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
}

.picker-close {
  font-size: 50rpx;
  color: #cccccc;
  padding: 0 10rpx;
}

/* 选择器主体 */
.picker-body {
  padding: 20rpx 0;
  max-height: 60vh;
  overflow-y: auto;
}

/* 分类项 */
.category-item {
  display: flex;
  align-items: center;
  padding: 24rpx 30rpx;
  transition: background-color 0.2s;
}

.category-item:active {
  background-color: #f5f5f5;
}

.category-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.category-name {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
}

.category-check {
  font-size: 32rpx;
  color: #07c160;
  font-weight: bold;
}
